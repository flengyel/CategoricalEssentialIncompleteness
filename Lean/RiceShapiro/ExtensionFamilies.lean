module

public import RiceShapiro.Approximation

/-!
# Generated domains and extension spans

This module proves that every generated domain admits an extension span and,
under `IsRP`, that every domain admitting an extension span is generated by the
range of the span's left leg. It also characterizes membership in generated
domains by total range lifting, proves extensionality of generated domains, and
formalizes countable extension families and their representation theorem.
-/

@[expose] public section

universe v u

namespace CategoryTheory

open PCategoryStruct PCategory DomSemilattice

variable {C : Type u} [Category.{v} C] [PCategoryStruct C] [PCategory C]
variable [HasRanges C] {X Y : C} (𝒜 : ApproximationDatum X Y)

namespace ApproximationDatum

/-- `b ⊠ 1_I` as a domain on `A ⊠ I`. -/
def bTimes (b : DomSemilattice 𝒜.A) : DomSemilattice (nearProd 𝒜.A 𝒜.I) :=
  ⟨nearProd_map b.hom (𝟙 𝒜.I), by rw [rst_nearProd_map, b.isDomain, rst_id]⟩

omit [HasRanges C] in
@[simp] lemma bTimes_hom (b : DomSemilattice 𝒜.A) :
    (𝒜.bTimes b).hom = nearProd_map b.hom (𝟙 𝒜.I) := rfl

/-- `d = e ∧ (b ⊠ 1_I)`, the apex domain of the span. Written with `b ⊠ 1`
outermost, matching `genHom`. -/
def spanDom (b : DomSemilattice 𝒜.A) : DomSemilattice (nearProd 𝒜.A 𝒜.I) :=
  meet (𝒜.bTimes b) 𝒜.ext

omit [HasRanges C] in
@[simp] lemma spanDom_hom (b : DomSemilattice 𝒜.A) :
    (𝒜.spanDom b).hom = nearProd_map b.hom (𝟙 𝒜.I) ≫ 𝒜.ext.hom := rfl

omit [HasRanges C] in
/-- `p₁ d = m_b`, the morphism whose range is `υ(b)`. -/
lemma spanDom_comp_p1 (b : DomSemilattice 𝒜.A) :
    (𝒜.spanDom b).hom ≫ p1 𝒜.A 𝒜.I = 𝒜.genHom b := by
  dsimp [spanDom, genHom, meet]
  rw [Category.assoc]

omit [HasRanges C] in
/-- `b o = o`: the left leg lands in `b`. -/
lemma spanDom_p0_comp (b : DomSemilattice 𝒜.A) :
    ((𝒜.spanDom b).hom ≫ p0 𝒜.A 𝒜.I) ≫ b.hom
      = (𝒜.spanDom b).hom ≫ p0 𝒜.A 𝒜.I := by
  rw [Category.assoc, ← p0_nat, ← Category.assoc]
  congr 1
  exact meet_le_left (𝒜.bTimes b) 𝒜.ext

/-- Every generated domain admits an extension span. -/
def generatedSpan (b : DomSemilattice 𝒜.A) : ExtensionSpan 𝒜 (𝒜.gen b) where
  T := nearProd 𝒜.A 𝒜.I
  o := (𝒜.spanDom b).hom ≫ p0 𝒜.A 𝒜.I
  r := (𝒜.spanDom b).hom ≫ p1 𝒜.A 𝒜.I
  ran_r := by rw [𝒜.spanDom_comp_p1 b]; rfl
  ext_pair := by
    rw [partialPairing_proj]
    exact meet_le_right (𝒜.bTimes b) 𝒜.ext
  p1_pair := by rw [partialPairing_proj]
  theta_le := by
    have hob : nearProd_map ((𝒜.spanDom b).hom ≫ p0 𝒜.A 𝒜.I) (𝟙 𝒜.I)
        ≫ nearProd_map b.hom (𝟙 𝒜.I)
        = nearProd_map ((𝒜.spanDom b).hom ≫ p0 𝒜.A 𝒜.I) (𝟙 𝒜.I) := by
      rw [nearProd_comp, 𝒜.spanDom_p0_comp b, Category.comp_id]
    have htheta :
        nearProd_map ((𝒜.spanDom b).hom ≫ p0 𝒜.A 𝒜.I) (𝟙 𝒜.I) ≫ 𝒜.genHom b
          = nearProd_map ((𝒜.spanDom b).hom ≫ p0 𝒜.A 𝒜.I) (𝟙 𝒜.I)
            ≫ 𝒜.ext.hom ≫ p1 𝒜.A 𝒜.I := by
      dsimp only [genHom]
      rw [← Category.assoc, hob]
    rw [← htheta, gen_hom]
    exact HasRanges.ran_comp_le _ _

/-- Membership in `υ(b)` and lifted preimages. The converse direction is
`gen_receives_index` and needs no lifting hypothesis. -/
theorem mem_gen_iff (b : DomSemilattice 𝒜.A)
    (hlift : HasTotalRangeLifting (𝒜.genHom b))
    {Z : C} (i : Z ⟶ 𝒜.I) (hi : rst i = 𝟙 Z) :
    i ≫ (𝒜.gen b).hom = i
      ↔ ∃ a : Z ⟶ 𝒜.A, rst a = 𝟙 Z ∧ a ≫ b.hom = a ∧ 𝒜.Extends a i := by
  constructor
  · intro h
    obtain ⟨u, -, hui⟩ := hlift i hi h
    have hdb : (𝒜.spanDom b).hom ≫ nearProd_map b.hom (𝟙 𝒜.I)
        = (𝒜.spanDom b).hom := meet_le_left (𝒜.bTimes b) 𝒜.ext
    have hde : (𝒜.spanDom b).hom ≫ 𝒜.ext.hom = (𝒜.spanDom b).hom :=
      meet_le_right (𝒜.bTimes b) 𝒜.ext
    have hwp1 : (u ≫ (𝒜.spanDom b).hom) ≫ p1 𝒜.A 𝒜.I = i := by
      rw [Category.assoc, 𝒜.spanDom_comp_p1 b]; exact hui
    have hwtot : rst (u ≫ (𝒜.spanDom b).hom) = 𝟙 Z := by
      rw [← rst_comp_p1 (u ≫ (𝒜.spanDom b).hom), hwp1]; exact hi
    have hwb : (u ≫ (𝒜.spanDom b).hom) ≫ nearProd_map b.hom (𝟙 𝒜.I)
        = u ≫ (𝒜.spanDom b).hom := by rw [Category.assoc, hdb]
    have hwe : (u ≫ (𝒜.spanDom b).hom) ≫ 𝒜.ext.hom
        = u ≫ (𝒜.spanDom b).hom := by rw [Category.assoc, hde]
    refine ⟨(u ≫ (𝒜.spanDom b).hom) ≫ p0 𝒜.A 𝒜.I, ?_, ?_, ?_⟩
    · rw [rst_comp_p0]; exact hwtot
    · rw [Category.assoc, ← p0_nat, ← Category.assoc, hwb]
    · have hx : partialPairing ((u ≫ (𝒜.spanDom b).hom) ≫ p0 𝒜.A 𝒜.I) i
            ≫ 𝒜.ext.hom
          = partialPairing ((u ≫ (𝒜.spanDom b).hom) ≫ p0 𝒜.A 𝒜.I) i := by
        rw [← hwp1, partialPairing_proj, hwe]
      exact hx
  · rintro ⟨a, ha, hab, hai⟩
    exact 𝒜.gen_receives_index ha hab hai

/-- Generated domains are extensional when preimages lift. -/
theorem gen_extensional (b : DomSemilattice 𝒜.A)
    (hlift : HasTotalRangeLifting (𝒜.genHom b)) :
    Extensional 𝒜.ev (𝒜.gen b) := by
  intro Z i j hi hj hev
  constructor
  · intro h
    obtain ⟨a, ha, hab, hai⟩ := (𝒜.mem_gen_iff b hlift i hi).mp h
    exact (𝒜.mem_gen_iff b hlift j hj).mpr
      ⟨a, ha, hab, (𝒜.extends_congr ha hi hj hev).mp hai⟩
  · intro h
    obtain ⟨a, ha, hab, hai⟩ := (𝒜.mem_gen_iff b hlift j hj).mp h
    exact (𝒜.mem_gen_iff b hlift i hi).mpr
      ⟨a, ha, hab, (𝒜.extends_congr ha hj hi hev.symm).mp hai⟩

end ApproximationDatum

/-- Half the converse: `s ≤ υ(ran o)`. Needs no `IsRP`. -/
theorem ExtensionSpan.le_gen {s : DomSemilattice 𝒜.I}
    (E : ExtensionSpan 𝒜 s) :
    s.hom ≫ (𝒜.gen ⟨HasRanges.ran E.o, HasRanges.rst_ran E.o⟩).hom = s.hom := by
  set b : DomSemilattice 𝒜.A := ⟨HasRanges.ran E.o, HasRanges.rst_ran E.o⟩
  have hpair : partialPairing E.o E.r ≫ nearProd_map b.hom (𝟙 𝒜.I)
      = partialPairing E.o E.r := by
    rw [partialPairing_comp_nearProd_map, Category.comp_id]
    congr 1
    exact HasRanges.comp_ran E.o
  have hfac : partialPairing E.o E.r ≫ 𝒜.genHom b = E.r := by
    dsimp only [ApproximationDatum.genHom]
    rw [← Category.assoc, hpair, ← Category.assoc, E.ext_pair, E.p1_pair]
  rw [← E.ran_r, ← hfac]
  exact HasRanges.ran_comp_le _ _

/-- The other half: `υ(ran o) ≤ s`. This is where `IsRP` is used, through
`ran (o ⊠ 1) = ran o ⊠ 1`. -/
theorem ExtensionSpan.gen_le [IsRP C] {s : DomSemilattice 𝒜.I}
    (E : ExtensionSpan 𝒜 s) :
    𝒜.gen ⟨HasRanges.ran E.o, HasRanges.rst_ran E.o⟩ ≤ s := by
  set b : DomSemilattice 𝒜.A := ⟨HasRanges.ran E.o, HasRanges.rst_ran E.o⟩
  have hob : nearProd_map E.o (𝟙 𝒜.I) ≫ nearProd_map b.hom (𝟙 𝒜.I)
      = nearProd_map E.o (𝟙 𝒜.I) := by
    rw [nearProd_comp, HasRanges.comp_ran, Category.comp_id]
  have htheta : nearProd_map E.o (𝟙 𝒜.I) ≫ 𝒜.genHom b
      = nearProd_map E.o (𝟙 𝒜.I) ≫ 𝒜.ext.hom ≫ p1 𝒜.A 𝒜.I := by
    dsimp only [ApproximationDatum.genHom]
    rw [← Category.assoc, hob]
  have hth : (nearProd_map E.o (𝟙 𝒜.I) ≫ 𝒜.ext.hom ≫ p1 𝒜.A 𝒜.I) ≫ s.hom
      = nearProd_map E.o (𝟙 𝒜.I) ≫ 𝒜.ext.hom ≫ p1 𝒜.A 𝒜.I :=
    HasRanges.comp_of_ran_le _ E.theta_le
  have hkey : nearProd_map E.o (𝟙 𝒜.I) ≫ 𝒜.genHom b ≫ s.hom
      = nearProd_map E.o (𝟙 𝒜.I) ≫ 𝒜.genHom b := by
    rw [← Category.assoc, htheta, hth, ← htheta]
  have hran := HasRanges.ran_uniq (nearProd_map E.o (𝟙 𝒜.I))
    (𝒜.genHom b ≫ s.hom) (𝒜.genHom b) hkey
  have hrp : HasRanges.ran (nearProd_map E.o (𝟙 𝒜.I))
      = nearProd_map b.hom (𝟙 𝒜.I) := by
    rw [IsRP.ran_nearProd_map, HasRanges.ran_id]
  rw [hrp] at hran
  have hbg : nearProd_map b.hom (𝟙 𝒜.I) ≫ 𝒜.genHom b = 𝒜.genHom b := by
    dsimp only [ApproximationDatum.genHom]
    rw [← Category.assoc, nearProd_comp, b.idem, Category.comp_id]
  change HasRanges.ran (𝒜.genHom b) ≫ s.hom = HasRanges.ran (𝒜.genHom b)
  apply HasRanges.ran_le_of_receives
  rw [← hbg, Category.assoc, hran]

/-- Extension spans generate domains: `s = υ(ran o)`. -/
theorem ExtensionSpan.gen_eq [IsRP C] {s : DomSemilattice 𝒜.I}
    (E : ExtensionSpan 𝒜 s) :
    𝒜.gen ⟨HasRanges.ran E.o, HasRanges.rst_ran E.o⟩ = s :=
  le_antisymm E.gen_le (E.le_gen : s ≤ _)

/-! ### Countable extension families

Clauses (C1)–(C3). The data need only a `P`-category with ranges: (C3) is
`IsStableUnion`, whose statement needs no coproduct. The countable coproduct
enters when the family is combined, not when it is described. -/

section Countable

open NCoprodStruct HasNCoproducts CountablyDistributive

/-- A countable extension family for `s`, clauses (C1)–(C3). -/
structure CountableExtensionFamily {X Y : C} (𝒜 : ApproximationDatum X Y)
    (s : DomSemilattice 𝒜.I) where
  /-- The apexes. -/
  T : ℕ → C
  /-- The legs into the approximation parameters. -/
  o : ∀ n, T n ⟶ 𝒜.A
  /-- The legs into the indices. -/
  r : ∀ n, T n ⟶ 𝒜.I
  /-- Every `oₙ` is total. -/
  o_total : ∀ n, rst (o n) = 𝟙 (T n)
  /-- Every `rₙ` is total. -/
  r_total : ∀ n, rst (r n) = 𝟙 (T n)
  /-- (C1) `e⟨oₙ, rₙ⟩ = ⟨oₙ, rₙ⟩`. -/
  c1 : ∀ n, 𝒜.Extends (o n) (r n)
  /-- (C2) `ran θₙ ≤ s`. -/
  c2 : ∀ n,
    HasRanges.ran (nearProd_map (o n) (𝟙 𝒜.I) ≫ 𝒜.ext.hom ≫ p1 𝒜.A 𝒜.I)
        ≫ s.hom
      = HasRanges.ran (nearProd_map (o n) (𝟙 𝒜.I) ≫ 𝒜.ext.hom ≫ p1 𝒜.A 𝒜.I)
  /-- (C3) `s = ⋁ ran rₙ`, as a stable union. -/
  c3 : DomSemilattice.IsStableUnion s fun n =>
    (⟨HasRanges.ran (r n), HasRanges.rst_ran _⟩ : DomSemilattice 𝒜.I)

variable [NCoprodStruct C] [HasNCoproducts C] [CountablyDistributive C]

/-- The countable coproduct of a `CountableExtensionFamily` is an extension
span.

No `IsRP` or binary-coproduct instance is required. The proof uses only
`F.c3.isUnion` and right countable distributivity; `F.r_total`, stability, and
left countable distributivity remain part of the bundled inputs. -/
def CountableExtensionFamily.toExtensionSpan {X Y : C}
    {𝒜 : ApproximationDatum X Y} {s : DomSemilattice 𝒜.I}
    (F : CountableExtensionFamily 𝒜 s) : ExtensionSpan 𝒜 s where
  T := ncoprod F.T
  o := ncopair F.o
  r := ncopair F.r
  ran_r :=
    congrArg DomSemilattice.hom
      ((HasRanges.ran_ncopair_isUnion F.r).unique F.c3.isUnion)
  ext_pair := by
    apply hom_ext
    intro n
    rw [← Category.assoc, comp_partialPairing, ninj_ncopair, ninj_ncopair]
    exact F.c1 n
  p1_pair := by
    rw [p1_partialPairing, isTotal_ncopair _ F.o_total, Category.id_comp]
  theta_le := by
    have hfac :
        nearProd_map (ncopair F.o) (𝟙 𝒜.I) ≫ 𝒜.ext.hom ≫ p1 𝒜.A 𝒜.I
          = distribR F.T 𝒜.I ≫ ncopair fun n =>
              nearProd_map (F.o n) (𝟙 𝒜.I) ≫ 𝒜.ext.hom ≫ p1 𝒜.A 𝒜.I := by
      rw [nearProd_ncopair_id, Category.assoc, ncopair_comp]
    rw [hfac, HasRanges.ran_comp_of_section _ (undistribR F.T 𝒜.I)
      (undistribR_distribR F.T 𝒜.I)]
    exact (HasRanges.ran_ncopair_isUnion _).le_of_forall_le F.c2

/-- `𝒜` admits countable extension families when every extensional domain has
one. -/
def HasCountableExtensionFamilies {X Y : C} (𝒜 : ApproximationDatum X Y) :
    Prop :=
  ∀ s : DomSemilattice 𝒜.I, Extensional 𝒜.ev s →
    Nonempty (CountableExtensionFamily 𝒜 s)

/-- Admitting countable extension families implies the extension-span
property. -/
theorem hasExtensionSpanProperty_of_countable {X Y : C}
    {𝒜 : ApproximationDatum X Y} (h : HasCountableExtensionFamilies 𝒜) :
    HasExtensionSpanProperty 𝒜 :=
  fun s hs => (h s hs).map fun F => F.toExtensionSpan

/-- The positive representation theorem: every extensional domain is a
generated domain. -/
theorem gen_eq_of_countableExtensionFamily [IsRP C] {X Y : C}
    {𝒜 : ApproximationDatum X Y} {s : DomSemilattice 𝒜.I}
    (F : CountableExtensionFamily 𝒜 s) :
    𝒜.gen ⟨HasRanges.ran F.toExtensionSpan.o,
      HasRanges.rst_ran _⟩ = s :=
  ExtensionSpan.gen_eq 𝒜 F.toExtensionSpan

/-- Rice–Shapiro from countable extension families, first assertion: a domain
with a countable extension family is a generated domain. -/
theorem exists_gen_eq_of_countableExtensionFamily [IsRP C] {X Y : C}
    {𝒜 : ApproximationDatum X Y} {s : DomSemilattice 𝒜.I}
    (F : CountableExtensionFamily 𝒜 s) :
    ∃ b : DomSemilattice 𝒜.A, 𝒜.gen b = s :=
  ⟨_, gen_eq_of_countableExtensionFamily F⟩

/-- The consequent assertion: if `𝒜` admits countable extension families, every
extensional domain is generated. -/
theorem exists_gen_eq_of_extensional [IsRP C] {X Y : C}
    {𝒜 : ApproximationDatum X Y} (h : HasCountableExtensionFamilies 𝒜)
    {s : DomSemilattice 𝒜.I} (hs : Extensional 𝒜.ev s) :
    ∃ b : DomSemilattice 𝒜.A, 𝒜.gen b = s := by
  obtain ⟨F⟩ := h s hs
  exact exists_gen_eq_of_countableExtensionFamily F

/-- Generated domains and extensional domains coincide, given countable
extension families and total range lifting for every `m_b`. -/
theorem extensional_iff_gen [IsRP C] {X Y : C} {𝒜 : ApproximationDatum X Y}
    (h : HasCountableExtensionFamilies 𝒜)
    (hlift : ∀ b : DomSemilattice 𝒜.A, HasTotalRangeLifting (𝒜.genHom b))
    (s : DomSemilattice 𝒜.I) :
    Extensional 𝒜.ev s ↔ ∃ b : DomSemilattice 𝒜.A, 𝒜.gen b = s := by
  constructor
  · intro hs
    exact exists_gen_eq_of_extensional h hs
  · rintro ⟨b, rfl⟩
    exact 𝒜.gen_extensional b (hlift b)

end Countable

end CategoryTheory
