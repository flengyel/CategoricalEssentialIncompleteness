module

public import CategoricalEssentialIncompleteness.V46ConcreteNamedComparisonPlainOccurrences

/-! # Literal plain-parser words retain the same numerical occurrence fold -/

@[expose] public section

noncomputable section
open FFL FFL.FirstOrder FFL.FirstOrder.Arithmetic FFL.Entailment
open CategoryTheory CategoryTheory.Limits
open CategoricalEssentialIncompleteness.V46
open CategoricalEssentialIncompleteness.V46.SyntacticPredicates
open CategoricalEssentialIncompleteness.V46.SyntacticLists
open CategoricalEssentialIncompleteness.V46.SyntacticSyntax
open CategoricalEssentialIncompleteness.V46.ConcreteNamedComparison
variable (T : ArithmeticTheory) [𝗣𝗔 ⪯ T]
variable (V : PredicateCategory T) (σ π : ℕ → PredicateCategory T) (d : ℕ)

example (M : Type) [ORingStructure M] [M↓[ℒₒᵣ] ⊧* T] [M↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    (word : Obj T M ((plainCategoricalSyntax T V σ π d).algebra.a.2)) :
    ((F T M).map (plainCategoricalSyntax T V σ π d).formulaOccurrences word).val =
      ConcreteNamedSubstitution.freeVariables V σ π d word.val :=
  plain_formulaOccurrences_value T V σ π d M word
