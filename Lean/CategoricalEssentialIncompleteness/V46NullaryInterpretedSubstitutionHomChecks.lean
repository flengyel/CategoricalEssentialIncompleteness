module

public import CategoricalEssentialIncompleteness.V46NullaryInterpretedSubstitutionHom

/-! # Statement checks for NullaryInterpretedSubstitutionHom -/

@[expose] public section

noncomputable section

universe v u
open CategoryTheory CategoryTheory.Limits
open CategoricalEssentialIncompleteness CategoricalEssentialIncompleteness.V46

variable {D : Type u} [Category.{v} D] [Regular D] [FinitaryExtensive D]
variable {V X : D}
variable (S : CategoricalSyntax V (fun _ => ⊥_ D) (fun _ => X) 0)
variable {σ π : ℕ → D} {d : ℕ} (Q : CategoricalSyntax V σ π d)
variable (f : X ⟶ Q.sentenceObject)
open NullaryInterpretation

example : parameterAlgebra S S.substitutionParameters ⟶ targetSubstitutionAlgebra S Q f :=
  interpretedSubstitutionHom S Q f

#print axioms CategoricalEssentialIncompleteness.V46.NullaryInterpretation.interpretedSubstitutionHom
