module

public import CategoricalEssentialIncompleteness.V46ApplicativeCodes

/-! # Polynomial morphisms and computability on formal finite powers

Cockett and Hofstra, Definitions 4.2 and 4.3, take the restriction subcategory
on the formal finite powers generated by application and the total points,
with the finite restriction-product operations.
-/

@[expose] public section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory PCategoryStruct PCategory RecursionCategory RestrictionCategory

namespace CategoricalEssentialIncompleteness.V46.ApplicativeSystem

universe v u
variable {C : Type u} [Category.{v} C] [PCategoryStruct C] [PCategory C]
variable {A Z : C} (app : nearProd A A ⟶ A) (t : ∀ X : C, X ⟶ Z)

/-- Polynomial morphisms on the formal finite powers, using a last-factor
projection and pairing to generate products of any finite number of copies of A. -/
inductive Polynomial : (n m : ℕ) → (power Z A n ⟶ power Z A m) → Prop where
  | ident (n) : Polynomial n n (𝟙 _)
  | comp {n m k f g} : Polynomial n m f → Polynomial m k g → Polynomial n k (f ≫ g)
  | domain {n m f} : Polynomial n m f → Polynomial n n (PCategoryStruct.rst f)
  | terminate (n) : Polynomial n 0 (t _)
  | point (p : Z ⟶ A) : isTotal p → Polynomial 0 1 p
  | application : Polynomial 2 1 app
  | first (k) : Polynomial (k+2) (k+1) (p0 (positivePower A k) A)
  | last (k) : Polynomial (k+2) 1 (p1 (positivePower A k) A)
  | pair {n k f g} : Polynomial n (k+1) f → Polynomial n 1 g →
      Polynomial n (k+2) (partialPairing f g)

/-- All scalar coordinates of a morphism into a nonempty finite power have codes. -/
def CodedCoordinates (n : ℕ) :
    (m : ℕ) → (power Z A n ⟶ positivePower A m) → Prop
  | 0, f => ∃ p : Z ⟶ A, Codes app t p n f
  | m+1, f => CodedCoordinates n m (f ≫ p0 _ _) ∧
      ∃ p : Z ⟶ A, Codes app t p n (f ≫ p1 _ _)

/-- For an output of arity zero, Definition 4.2(ii) tests the coordinates of the
domain endomorphism. At input arity zero there are no coordinates. The domain of
a coded partial point then gives the scalar restriction in the computable category. -/
def CodedDomain : (n : ℕ) → (power Z A n ⟶ Z) → Prop
  | 0, f => ∃ g : Z ⟶ A, PCategoryStruct.rst f = PCategoryStruct.rst g ∧
      ∃ p : Z ⟶ A, Codes app t p 0 g
  | n+1, f => CodedCoordinates app t (n+1) n (PCategoryStruct.rst f)

/-- Computability on formal powers of an applicative system, including the
domain endomorphism at terminal output and every coordinate at positive output. -/
def Computable (n : ℕ) : (m : ℕ) → (power Z A n ⟶ power Z A m) → Prop
  | 0, f => CodedDomain app t n f
  | m+1, f => CodedCoordinates app t n m f

/-- Combinatory completeness at scalar output. The coordinate and terminal
domain clauses for arbitrary outputs are proved in `polynomial_iff_computable`. -/
def CombinatoriallyComplete : Prop :=
  ∀ (n : ℕ) (f : power Z A n ⟶ A), Polynomial app t n 1 f →
    ∃ p : Z ⟶ A, Codes app t p n f

theorem applyPositive_polynomial (p : Z ⟶ A) (hp : isTotal p) (n : ℕ) :
    Polynomial app t (n+1) 1 (applyPositive app t p n) := by
  induction n with
  | zero =>
    exact ((Polynomial.pair ((Polynomial.terminate 1).comp (.point p hp))
      (.ident 1)).comp Polynomial.application)
  | succ n ih =>
    change Polynomial app t (n+2) 1 (nearProd_map _ (𝟙 A) ≫ app)
    rw [nearProd_eq_partialPairing, Category.comp_id]
    exact ((Polynomial.pair ((Polynomial.first n).comp ih)
      (.last n)).comp Polynomial.application)

theorem polynomial_of_code (p : Z ⟶ A) {n} {f : power Z A n ⟶ A}
    (h : Codes app t p n f) : Polynomial app t n 1 f := by
  cases n with
  | zero =>
    obtain ⟨hp, rfl⟩ := h
    rw [← partialPairing_id_id]
    exact (Polynomial.point p hp).comp ((Polynomial.pair (.ident 1) (.ident 1)).comp .application)
  | succ n =>
    cases n with
    | zero =>
      obtain ⟨hp, rfl⟩ := h
      exact applyPositive_polynomial app t p hp 0
    | succ k =>
      obtain ⟨hp, _, rfl⟩ := h
      exact applyPositive_polynomial app t p hp (k+1)

private theorem polynomial_positive_iff (h : CombinatoriallyComplete app t)
    (n m : ℕ) (f : power Z A n ⟶ positivePower A m) :
    Polynomial app t n (m+1) f ↔ CodedCoordinates app t n m f := by
  induction m with
  | zero =>
    exact ⟨h n f, fun ⟨p, hp⟩ => polynomial_of_code app t p hp⟩
  | succ m ih =>
    constructor
    · intro hf
      exact ⟨(ih _).mp (hf.comp (.first m)), h n _ (hf.comp (.last m))⟩
    · rintro ⟨left, p, right⟩
      rw [← partialPairing_proj f]
      exact Polynomial.pair ((ih _).mpr left) (polynomial_of_code app t p right)

/-- Under combinatory completeness the category of polynomial morphisms has
exactly the computable morphisms, including the domain condition at the empty power. -/
theorem polynomial_iff_computable (h : CombinatoriallyComplete app t)
    (endAtUnit : ∀ {X : C} (f : X ⟶ Z), f = PCategoryStruct.rst f ≫ t X)
    (n m : ℕ) (f : power Z A n ⟶ power Z A m) :
    Polynomial app t n m f ↔ Computable app t n m f := by
  cases m with
  | succ k => exact polynomial_positive_iff app t h n k f
  | zero =>
    cases n with
    | succ n =>
      change _ ↔ CodedCoordinates app t (n+1) n (PCategoryStruct.rst f)
      rw [← polynomial_positive_iff app t h]
      exact ⟨fun hf => hf.domain, fun hf => (endAtUnit f).symm ▸ hf.comp (.terminate _)⟩
    | zero =>
      constructor
      · intro hf
        obtain ⟨p, hp⟩ := h 1 (𝟙 A) (Polynomial.ident 1)
        have total : isTotal p := hp.1
        refine ⟨f ≫ p, ?_, h 0 _ (hf.comp (.point p total))⟩
        exact (rst_comp_of_isTotal' f total).symm
      · rintro ⟨g, dom, p, code⟩
        have hf : f = PCategoryStruct.rst g ≫ t Z := (endAtUnit f).trans (by rw [dom]; rfl)
        rw [hf]
        exact (Polynomial.domain (polynomial_of_code app t p code)).comp (.terminate 0)

theorem turing_combinatoriallyComplete (h : IsTuringMorphism app) (ht : isTotal (t A)) :
    CombinatoriallyComplete app t := fun n f _ => exists_code app t h ht n f

end CategoricalEssentialIncompleteness.V46.ApplicativeSystem
