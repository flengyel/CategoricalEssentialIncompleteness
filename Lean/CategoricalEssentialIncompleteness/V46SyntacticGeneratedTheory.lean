module

public import CategoricalEssentialIncompleteness.V46SyntacticSyntaxPlain
public import CategoricalEssentialIncompleteness.V46SyntacticDerivationInitial
public import CategoricalEssentialIncompleteness.V46FirstOrderTheory
public import CategoricalEssentialIncompleteness.V46SentenceTheoryClosure
public import CategoricalEssentialIncompleteness.V46SyntacticSentenceRanges

/-! # The first-order theory generated by the constructed syntactic algebras -/

@[expose] public section

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open FFL FFL.FirstOrder FFL.FirstOrder.Arithmetic FFL.Entailment
open CategoryTheory CategoryTheory.Limits CategoryTheory.RestrictionCategory
open FailureOfComposition.TypedProgramCategory
open CategoricalEssentialIncompleteness.LocalConnectedness
open CategoricalEssentialIncompleteness.V46.SyntacticPredicates

namespace CategoricalEssentialIncompleteness.V46.SyntacticGeneratedTheory
variable (T : ArithmeticTheory) [𝗣𝗔 ⪯ T]
variable (V : PredicateCategory T) (σ π : ℕ → PredicateCategory T) (d : ℕ)
local notation "S" => SyntacticSyntax.plainCategoricalSyntax T V σ π d

/-- The finite-rule algebra for the seven logical schemes, generalization, modus ponens
and the given nonlogical axioms. -/
def proofAlgebra {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) :
    Endofunctor.Algebra ((S).logicalRules axioms).inference :=
  SyntacticDerivation.derivationAlgebra T ((S).logicalRules axioms)

def proofInitial {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) :
    IsInitial (proofAlgebra T V σ π d axioms) :=
  SyntacticDerivation.derivationInitial T ((S).logicalRules axioms)

def conclusion {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) :
    (proofAlgebra T V σ π d axioms).a.left ⟶ (S).algebra.a.2 :=
  (proofAlgebra T V σ π d axioms).a.hom

def formulaTheory {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) :
    Subobject (S).algebra.a.2 := imageSubobject (conclusion T V σ π d axioms)

def sentenceProofObject {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) :
    PredicateCategory T := pullback (conclusion T V σ π d axioms) (S).sentenceInclusion

def sentenceConclusion {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) :
    sentenceProofObject T V σ π d axioms ⟶ (S).sentenceObject :=
  pullback.snd (conclusion T V σ π d axioms) (S).sentenceInclusion

def sentenceTheory {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) :
    Subobject (S).sentenceObject := imageSubobject (sentenceConclusion T V σ π d axioms)

/-- Formula closure and leastness use the constructed derivation algebra;
no existence or initiality hypothesis is supplied to this theorem. -/
theorem generated_theory {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) :
    ClosedUnder ((S).logicalRules axioms).inference
        (image.ι (conclusion T V σ π d axioms)) ∧
      (∀ {U : PredicateCategory T} (m : U ⟶ (S).algebra.a.2) [Mono m],
        ClosedUnder ((S).logicalRules axioms).inference m →
          ∃ w : image (conclusion T V σ π d axioms) ⟶ U,
            w ≫ m = image.ι (conclusion T V σ π d axioms)) ∧
      (∃ a : (S).logicalParameters ⨿ A ⟶ image (conclusion T V σ π d axioms),
        a ≫ image.ι (conclusion T V σ π d axioms) =
          coprod.desc (S).logicalAxioms (axioms ≫ (S).sentenceInclusion)) ∧
      sentenceTheory T V σ π d axioms =
        (Subobject.pullback (S).sentenceInclusion).obj (formulaTheory T V σ π d axioms) :=
  (S).generated_firstOrder_theory axioms (proofAlgebra T V σ π d axioms)
    (proofInitial T V σ π d axioms)

theorem sentence_theory_pullback {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) :
    sentenceTheory T V σ π d axioms =
      (Subobject.pullback (S).sentenceInclusion).obj (formulaTheory T V σ π d axioms) :=
  (generated_theory T V σ π d axioms).2.2.2

/-- Nonlogical axioms factor through the image of the sentence-conclusion map, rather than
merely through the formula image. -/
theorem sentence_axioms_factor {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) :
    ∃ a : A ⟶ image (sentenceConclusion T V σ π d axioms),
      a ≫ image.ι (sentenceConclusion T V σ π d axioms) = axioms := by
  obtain ⟨g, hg⟩ := (generated_theory T V σ π d axioms).2.2.1
  let c := conclusion T V σ π d axioms
  let j := (S).sentenceInclusion
  let u : A ⟶ image c := coprod.inr ≫ g
  have hu : u ≫ image.ι c = axioms ≫ j := by
    rw [Category.assoc, hg, coprod.inr_desc]
  refine ⟨pullback.lift u axioms hu ≫ (sentenceImageIso c j).hom, ?_⟩
  change (pullback.lift u axioms hu ≫ (sentenceImageIso c j).hom) ≫
    image.ι (pullback.snd c j) = axioms
  rw [Category.assoc, sentenceImageIso_hom_ι, pullback.lift_snd]

/-- A sentence subobject is a theory when conclusions of its own finite
proofs factor through it. This is the sentence-theory definition of
Appendix A, with the derivation algebra constructed rather than assumed. -/
def IsSentenceTheory {U : PredicateCategory T} (m : U ⟶ (S).sentenceObject) : Prop :=
  ∃ w : sentenceProofObject T V σ π d m ⟶ U,
    w ≫ m = sentenceConclusion T V σ π d m

/-- The sentence image of a generated theory is closed under derivability
from that sentence image itself. -/
theorem sentence_theory_closed {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) :
    IsSentenceTheory T V σ π d (image.ι (sentenceConclusion T V σ π d axioms)) :=
  firstOrder_generated_sentence_closed (S).logicalAxioms (S).sentenceInclusion axioms
    (S).quantifierConstructor (S).implicationConstructor
    (proofAlgebra T V σ π d axioms) (proofInitial T V σ π d axioms)
    (proofAlgebra T V σ π d (image.ι (sentenceConclusion T V σ π d axioms)))
    (proofInitial T V σ π d (image.ι (sentenceConclusion T V σ π d axioms)))

/-- Every sentence theory containing the nonlogical axioms contains
the generated sentence image. -/
theorem sentence_theory_least {A U : PredicateCategory T}
    (axioms : A ⟶ (S).sentenceObject) (m : U ⟶ (S).sentenceObject) [Mono m]
    (hm : IsSentenceTheory T V σ π d m) (k : A ⟶ U) (hk : k ≫ m = axioms) :
    sentenceTheory T V σ π d axioms ≤ Subobject.mk m := by
  obtain ⟨w, hw⟩ := hm
  exact firstOrder_generated_sentence_least (S).logicalAxioms (S).sentenceInclusion axioms
    (S).quantifierConstructor (S).implicationConstructor
    (proofAlgebra T V σ π d axioms) (proofInitial T V σ π d axioms) m
    (proofAlgebra T V σ π d m) k hk w hw

/-- Generating from the generated sentence subobject is idempotent. -/
theorem sentence_theory_idempotent {A : PredicateCategory T}
    (axioms : A ⟶ (S).sentenceObject) :
    sentenceTheory T V σ π d (image.ι (sentenceConclusion T V σ π d axioms)) =
      sentenceTheory T V σ π d axioms := by
  let m := image.ι (sentenceConclusion T V σ π d axioms)
  obtain ⟨w, hw⟩ := sentence_theory_closed T V σ π d axioms
  obtain ⟨a, ha⟩ := sentence_axioms_factor T V σ π d m
  apply le_antisymm
  · exact imageSubobject_le_mk m (sentenceConclusion T V σ π d m) w hw
  · exact Subobject.mk_le_mk_of_comm a ha

/-- Inclusion of nonlogical axioms induces inclusion of the generated sentence theories. -/
theorem sentence_theory_monotone {A A' : PredicateCategory T}
    (axioms : A ⟶ (S).sentenceObject) (axioms' : A' ⟶ (S).sentenceObject)
    (k : A ⟶ A') (hk : k ≫ axioms' = axioms) :
    sentenceTheory T V σ π d axioms ≤ sentenceTheory T V σ π d axioms' :=
  firstOrder_sentence_image_monotone (S).logicalAxioms (S).sentenceInclusion axioms axioms'
    (S).quantifierConstructor (S).implicationConstructor k hk
    (proofAlgebra T V σ π d axioms) (proofInitial T V σ π d axioms)
    (proofAlgebra T V σ π d axioms')

/-- The sentence predicate and theorem predicate share the formula-code
coordinate, independently of the sentence object's pullback coding. -/
def sentencePredicate {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) : Carrier :=
  SyntacticSentenceImages.theoryCarrier T (conclusion T V σ π d axioms) (S).sentenceInclusion

def sentencePredicateIso {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) :
    CategoryTheory.Iso (C := PredicateCategory T)
      (image (sentenceConclusion T V σ π d axioms)) (sentencePredicate T V σ π d axioms) :=
  SyntacticSentenceImages.sentenceImageIso T (conclusion T V σ π d axioms) (S).sentenceInclusion

def sentenceRestriction {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) :
    Idem (omegaObject T) :=
  SyntacticSentenceImages.theoryIdem T (conclusion T V σ π d axioms) (S).sentenceInclusion

/-- The splitting of the source restriction idempotent is the constructed generated
sentence theory. -/
def sentenceRestrictionSplitting {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) :
    interpretedObject T (sentencePredicate T V σ π d axioms) ≅
      (realization T).obj (image (sentenceConclusion T V σ π d axioms)) :=
  SyntacticSentenceImages.theorySplittingIso T
    (conclusion T V σ π d axioms) (S).sentenceInclusion

/-- The explicit index uses the program graph, so its sentence filter is already
PA-functional independently of ambient T-totality. -/
def sentenceConclusionIndex {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) : ℕ :=
  SyntacticSentenceImages.sentenceIndex T
    (conclusion T V σ π d axioms) (S).sentenceInclusion

def literalSentencePredicate {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) : Carrier :=
  SyntacticSentenceImages.programTheoryCarrier T
    (conclusion T V σ π d axioms) (S).sentenceInclusion

def literalSentenceRestriction {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) :
    Idem (omegaObject T) := predicateIdem T (literalSentencePredicate T V σ π d axioms)

theorem sentenceConclusion_range {A : PredicateCategory T} (axioms : A ⟶ (S).sentenceObject) :
    FailureOfComposition.TypedRanges.rangeArrow T
      (SyntacticSentenceImages.sentenceProgram T
        (conclusion T V σ π d axioms) (S).sentenceInclusion) =
      (literalSentenceRestriction T V σ π d axioms).hom :=
  SyntacticSentenceImages.sentenceProgram_range_literal T
    (conclusion T V σ π d axioms) (S).sentenceInclusion

def literalSentenceRestrictionSplitting {A : PredicateCategory T}
    (axioms : A ⟶ (S).sentenceObject) :
    interpretedObject T (literalSentencePredicate T V σ π d axioms) ≅
      (realization T).obj (image (sentenceConclusion T V σ π d axioms)) :=
  SyntacticSentenceImages.programTheorySplittingIso T
    (conclusion T V σ π d axioms) (S).sentenceInclusion

end CategoricalEssentialIncompleteness.V46.SyntacticGeneratedTheory
