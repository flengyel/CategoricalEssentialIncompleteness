module
public import CategoricalEssentialIncompleteness.V46ArithmeticSignedSplitGenerators
public import CategoricalEssentialIncompleteness.V46ArithmeticSignedTotalSyntax

/-! # The arithmetic diagonal signed theory

This is the predicate-equivalence realization of the printed free theory
in the total restriction splitting. The target proof carrier is generated
from the join of the two signed images. Every axiom presentation is handled
through its regular image, and initiality is indexed only by subobjects.
-/
@[expose] public section
noncomputable section
open FFL FFL.FirstOrder FFL.FirstOrder.Arithmetic
open CategoryTheory CategoryTheory.Limits
open CategoricalEssentialIncompleteness.LocalConnectedness
open CategoricalEssentialIncompleteness.V46.SyntacticPredicates

namespace CategoricalEssentialIncompleteness.V46.ArithmeticSignedTheory
local notation "N" => (PrintedObjectCoding.Number : PredicateCategory 𝗣𝗔)

def presentation : NullaryPresentations (D := PredicateCategory 𝗣𝗔) N :=
  SyntacticDerivation.nullaryPresentations 𝗣𝗔 N

/-- Lemma 8.9, including consistency and the unrestricted closed-extension
quantifier, for the constructed free theory in the restriction splitting. -/
theorem printed_statement : Entailment.Consistent 𝗣𝗔 →
    Inseparable (SplitObject.includedIdem ArithmeticDiagonalCodes.a0)
      (SplitObject.includedIdem ArithmeticDiagonalCodes.a1) ∧
    ((ArithmeticSignedTotal.theory presentation).val ⊓
      (Subobject.pullback (ArithmeticSignedTotal.negation presentation)).obj
        (ArithmeticSignedTotal.theory presentation).val = ⊥) ∧
    ∀ U : FirstOrderReflection.Theory (ArithmeticSignedTotal.proofs presentation),
      (ArithmeticSignedTotal.theory presentation).val ≤ U.val →
      U.val ⊓ (Subobject.pullback (ArithmeticSignedTotal.negation presentation)).obj U.val = ⊥ →
      U.val ⊔ (Subobject.pullback (ArithmeticSignedTotal.negation presentation)).obj U.val ≠ ⊤ :=
  fun _ => ⟨ArithmeticDiagonalSplitting.source_pair_inseparable,
    ArithmeticSignedTotal.essentially_incomplete presentation⟩

/-- An arbitrary target axiom morphism is generated by its regular image;
no initial algebra for that morphism is added to the hypotheses. -/
theorem presentation_generation {A : TotalSplit 𝗣𝗔}
    (a : A ⟶ (realization 𝗣𝗔).obj (presentation.syntaxData N).sentenceObject) :
    ((FirstOrderReflection.presentationGeneration (ArithmeticSignedTotal.proofs presentation)
      (ArithmeticSignedTotal.initial presentation)).obj (Over.mk a)).val =
      FirstOrderReflection.generated (ArithmeticSignedTotal.proofs presentation)
        (imageSubobject a) :=
  FirstOrderReflection.presentationGeneration_obj _ _ _

end CategoricalEssentialIncompleteness.V46.ArithmeticSignedTheory
