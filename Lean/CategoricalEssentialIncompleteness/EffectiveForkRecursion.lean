module

public import CategoricalEssentialIncompleteness.EffectiveForkProductFrame
public import CategoricalEssentialIncompleteness.EffectiveForkCoproductFrame
public import CategoricalEssentialIncompleteness.EffectiveForkWordFrame
public import CategoricalEssentialIncompleteness.EffectiveForkTuring
public import CategoricalEssentialIncompleteness.RangeFunctor
public import CategoricalEssentialIncompleteness.LocalLifting
public import Mathlib.CategoryTheory.ObjectProperty.FullSubcategory

/-! # The full recursion subcategory generated by the universal fork -/

@[expose] public section

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
noncomputable section
open CategoryTheory CategoryTheory.RestrictionCategory CategoryTheory.Limits
open CategoryTheory.PCategoryStruct (nearProd nearProd_map)
open CategoryTheory.CoprodStruct

namespace CategoricalEssentialIncompleteness.LocalConnectedness.EffectiveFork.Recursion

inductive Generated : Object → Prop
  | universal : Generated V
  | product {X Y} : Generated X → Generated Y → Generated (EffectiveFork.product X Y)
  | coproduct {X Y} : Generated X → Generated Y → Generated (EffectiveFork.coproduct X Y)
  | words {X} : Generated X → Generated (EffectiveFork.words X)

abbrev Rec := ObjectProperty.FullSubcategory (Generated : ObjectProperty Object)

def inclusion : Rec ⥤ Object := ObjectProperty.ι (Generated : ObjectProperty Object)

instance : inclusion.Faithful := inferInstanceAs ((ObjectProperty.ι (Generated : ObjectProperty Object)).Faithful)
instance : inclusion.Full := inferInstanceAs ((ObjectProperty.ι (Generated : ObjectProperty Object)).Full)

instance : HasZeroMorphisms Rec where
  zero := fun _ _ => ⟨ObjectProperty.homMk 0⟩
  zero_comp := by
    intro X Y Z f
    exact ObjectProperty.hom_ext _ zero_comp
  comp_zero := by
    intro X Y f Z
    exact ObjectProperty.hom_ext _ comp_zero

instance : PCategoryStruct Rec where
  nearProd X Y := ⟨EffectiveFork.product X.obj Y.obj,Generated.product X.property Y.property⟩
  nearProd_map f g := ObjectProperty.homMk (productMap f.hom g.hom)
  diag X := ObjectProperty.homMk (diagonal X.obj)
  p0 X Y := ObjectProperty.homMk (first X.obj Y.obj)
  p1 X Y := ObjectProperty.homMk (second X.obj Y.obj)

instance : PCategory Rec where
  nearProd_id X Y := ObjectProperty.hom_ext _ (PCategory.nearProd_id X.obj Y.obj)
  nearProd_comp f g h k := ObjectProperty.hom_ext _ (PCategory.nearProd_comp f.hom g.hom h.hom k.hom)
  diag_p0 X := ObjectProperty.hom_ext _ (PCategory.diag_p0 X.obj)
  diag_p1 X := ObjectProperty.hom_ext _ (PCategory.diag_p1 X.obj)
  diag_p0_p1 X Y := ObjectProperty.hom_ext _ (PCategory.diag_p0_p1 X.obj Y.obj)
  p0_p0 X Y Z := ObjectProperty.hom_ext _ (PCategory.p0_p0 X.obj Y.obj Z.obj)
  p0_p1 X Y Z := ObjectProperty.hom_ext _ (PCategory.p0_p1 X.obj Y.obj Z.obj)
  p1_p0 X Y Z := ObjectProperty.hom_ext _ (PCategory.p1_p0 X.obj Y.obj Z.obj)
  p1_p1 X Y Z := ObjectProperty.hom_ext _ (PCategory.p1_p1 X.obj Y.obj Z.obj)
  diag_nat f := ObjectProperty.hom_ext _ (PCategory.diag_nat f.hom)
  p0_nat f := ObjectProperty.hom_ext _ (PCategory.p0_nat f.hom)
  p1_nat f := ObjectProperty.hom_ext _ (PCategory.p1_nat f.hom)
  assoc_nat f g h := ObjectProperty.hom_ext _ (PCategory.assoc_nat f.hom g.hom h.hom)
  swap_nat f g := ObjectProperty.hom_ext _ (PCategory.swap_nat f.hom g.hom)

theorem induced_restriction {X Y : Rec} (f : X ⟶ Y) :
    PCategoryStruct.rst f=rst f := rfl

theorem restriction_hom {X Y : Rec} (f : X ⟶ Y) :
    (rst f).hom=rst f.hom := EffectiveFork.induced_restriction f.hom

instance : RestrictionZero Rec := ⟨fun X Y => by
  apply ObjectProperty.hom_ext
  rw [restriction_hom]
  exact RestrictionZero.restrict_zero X.obj Y.obj⟩

def toIdem {X : Rec} (a : Idem X) : Idem X.obj :=
  ⟨a.hom.hom,by
    have h := congrArg (fun f => f.hom) a.restriction
    rwa [restriction_hom] at h⟩

def ofIdem {X : Rec} (a : Idem X.obj) : Idem X :=
  ⟨ObjectProperty.homMk a.hom,by
    apply ObjectProperty.hom_ext
    rw [restriction_hom]
    exact a.restriction⟩

def idemOrderIso (X : Rec) : Idem X ≃o Idem X.obj where
  toFun := toIdem
  invFun := ofIdem
  left_inv _ := rfl
  right_inv _ := rfl
  map_rel_iff' := ⟨fun h => ObjectProperty.hom_ext _ h,fun h => congrArg (fun k => k.hom) h⟩

instance : BinaryJoins Rec where
  join a b := ofIdem (toIdem a ⊔ toIdem b)
  le_left a b := (idemOrderIso _).symm.monotone le_sup_left
  le_right a b := (idemOrderIso _).symm.monotone le_sup_right
  least a b c ha hb := (idemOrderIso _).symm.monotone
    (sup_le ((idemOrderIso _).monotone ha) ((idemOrderIso _).monotone hb))

theorem toIdem_sup {X : Rec} (a b : Idem X) :
    toIdem (a ⊔ b)=toIdem a ⊔ toIdem b := rfl

theorem toIdem_pull {X Y : Rec} (f : X ⟶ Y) (a : Idem Y) :
    toIdem (Idem.pull f a)=Idem.pull f.hom (toIdem a) := by
  apply Idem.ext
  exact restriction_hom (f ≫ a.hom)

instance : JoinInverse Rec where
  pull_sup f a b := by
    apply (idemOrderIso _).injective
    change toIdem (Idem.pull f (a ⊔ b))=toIdem (Idem.pull f a ⊔ Idem.pull f b)
    rw [toIdem_pull,toIdem_sup,toIdem_sup,toIdem_pull,toIdem_pull]
    exact JoinInverse.pull_sup f.hom (toIdem a) (toIdem b)

instance : Ranges Rec where
  range f := ofIdem (Ranges.range f.hom)
  receives f := ObjectProperty.hom_ext _ (Ranges.receives f.hom)
  agreement f g h he := ObjectProperty.hom_ext _ (Ranges.agreement f.hom g.hom h.hom
    (congrArg (fun k => k.hom) he))

instance : RecursionCategory.Prodominical Rec where
  nearProd_zero_right {A B X Y} f := ObjectProperty.hom_ext _
    (RecursionCategory.Prodominical.nearProd_zero_right (X := X.obj) (Y := Y.obj) f.hom)
  nearProd_zero_left {A B X Y} f := ObjectProperty.hom_ext _
    (RecursionCategory.Prodominical.nearProd_zero_left (X := X.obj) (Y := Y.obj) f.hom)

instance : CoprodStruct Rec where
  coprod X Y := ⟨EffectiveFork.coproduct X.obj Y.obj,Generated.coproduct X.property Y.property⟩
  coprod_map f g := ObjectProperty.homMk (coproductMap f.hom g.hom)
  i0 X Y := ObjectProperty.homMk (inl X.obj Y.obj)
  i1 X Y := ObjectProperty.homMk (inr X.obj Y.obj)
  codiag X := ObjectProperty.homMk (codiagonal X.obj)

instance : CategoryTheory.HasCoproducts Rec where
  coprod_id X Y := ObjectProperty.hom_ext _ (CategoryTheory.HasCoproducts.coprod_id X.obj Y.obj)
  coprod_comp f g h k := ObjectProperty.hom_ext _
    (CategoryTheory.HasCoproducts.coprod_comp f.hom g.hom h.hom k.hom)
  i0_codiag X := ObjectProperty.hom_ext _ (CategoryTheory.HasCoproducts.i0_codiag X.obj)
  i1_codiag X := ObjectProperty.hom_ext _ (CategoryTheory.HasCoproducts.i1_codiag X.obj)
  i0_i1_codiag X Y := ObjectProperty.hom_ext _ (CategoryTheory.HasCoproducts.i0_i1_codiag X.obj Y.obj)
  codiag_nat f := ObjectProperty.hom_ext _ (CategoryTheory.HasCoproducts.codiag_nat f.hom)
  i0_nat f := ObjectProperty.hom_ext _ (CategoryTheory.HasCoproducts.i0_nat f.hom)
  i0_nat_right f := ObjectProperty.hom_ext _ (CategoryTheory.HasCoproducts.i0_nat_right f.hom)
  i1_nat f := ObjectProperty.hom_ext _ (CategoryTheory.HasCoproducts.i1_nat f.hom)
  i1_nat_left f := ObjectProperty.hom_ext _ (CategoryTheory.HasCoproducts.i1_nat_left f.hom)

instance : RestrictionCoproducts Rec where
  total_i0 X Y := by
    apply ObjectProperty.hom_ext
    rw [restriction_hom]
    exact RestrictionCoproducts.total_i0 X.obj Y.obj
  total_i1 X Y := by
    apply ObjectProperty.hom_ext
    rw [restriction_hom]
    exact RestrictionCoproducts.total_i1 X.obj Y.obj

def rangeFunctor : RangeFunctor Rec Object where
  toFunctor := inclusion
  map_restrict := restriction_hom
  map_range _ := rfl
  map_zero _ _ := rfl
  comparison_isIso X Y := by
    have he : coproductComparison inclusion X Y=𝟙 (EffectiveFork.coproduct X.obj Y.obj) :=
      CategoryTheory.HasCoproducts.copair_i0_i1 X.obj Y.obj
    rw [he]
    exact (Iso.refl (EffectiveFork.coproduct X.obj Y.obj)).isIso_hom

def U : Rec := ⟨V,Generated.universal⟩
def turing : nearProd U U ⟶ U := ObjectProperty.homMk tau

theorem turing_isTuring : RecursionCategory.IsTuringMorphism turing := by
  intro X f
  obtain ⟨c,hc,he⟩ := tau_isTuring X.obj f.hom
  exact ⟨ObjectProperty.homMk c,ObjectProperty.hom_ext _ hc,ObjectProperty.hom_ext _ he⟩

def productIso {X Y X' Y' : Object} (i : X ≅ X') (j : Y ≅ Y') :
    EffectiveFork.product X Y ≅ EffectiveFork.product X' Y' where
  hom := productMap i.hom j.hom
  inv := productMap i.inv j.inv
  hom_inv_id := by
    change nearProd_map i.hom j.hom ≫ nearProd_map i.inv j.inv=𝟙 _
    rw [PCategory.nearProd_comp,i.hom_inv_id,j.hom_inv_id,PCategory.nearProd_id]
  inv_hom_id := by
    change nearProd_map i.inv j.inv ≫ nearProd_map i.hom j.hom=𝟙 _
    rw [PCategory.nearProd_comp,i.inv_hom_id,j.inv_hom_id,PCategory.nearProd_id]

def coproductIso {X Y X' Y' : Object} (i : X ≅ X') (j : Y ≅ Y') :
    EffectiveFork.coproduct X Y ≅ EffectiveFork.coproduct X' Y' where
  hom := coproductMap i.hom j.hom
  inv := coproductMap i.inv j.inv
  hom_inv_id := by
    change coprod_map i.hom j.hom ≫ coprod_map i.inv j.inv=𝟙 _
    rw [CategoryTheory.HasCoproducts.coprod_comp,i.hom_inv_id,j.hom_inv_id,
      CategoryTheory.HasCoproducts.coprod_id]
  inv_hom_id := by
    change coprod_map i.inv j.inv ≫ coprod_map i.hom j.hom=𝟙 _
    rw [CategoryTheory.HasCoproducts.coprod_comp,i.inv_hom_id,j.inv_hom_id,
      CategoryTheory.HasCoproducts.coprod_id]

theorem Generated.iso {X : Object} (h : Generated X) : Nonempty (V ≅ X) := by
  induction h with
  | universal => exact ⟨Iso.refl V⟩
  | product _ _ ih0 ih1 =>
    obtain ⟨i⟩ := ih0
    obtain ⟨j⟩ := ih1
    exact ⟨productFrame ≪≫ productIso i j⟩
  | coproduct _ _ ih0 ih1 =>
    obtain ⟨i⟩ := ih0
    obtain ⟨j⟩ := ih1
    exact ⟨coproductFrame ≪≫ coproductIso i j⟩
  | words _ ih =>
    obtain ⟨i⟩ := ih
    exact ⟨wordFrame ≪≫ wordIso i⟩

instance : RecursionCategory.Isotype Rec where
  iso X Y := by
    obtain ⟨i⟩ := X.property.iso
    obtain ⟨j⟩ := Y.property.iso
    exact ⟨ObjectProperty.isoMk _ (i.symm ≪≫ j)⟩

instance recursionCategory : RecursionCategory.PRecursionCategory Rec where
  W := U
  X := U
  Y := U
  tau := turing
  is_turing := turing_isTuring

def sumFrame : U ≅ coprod U U := ObjectProperty.isoMk _ coproductFrame

theorem inclusion_nonzero : rangeFunctor.toFunctor.map (𝟙 U)≠0 := by
  intro h
  have hh := congrArg (fun f => EnumerableCarriers.val f.center 0) h
  have h0 : 0 ∈ EnumerableCarriers.val (𝟙 V : V ⟶ V).center 0 :=
    (mem_supportIdentity Set.univ 0 0).mpr ⟨Set.mem_univ _,rfl⟩
  change EnumerableCarriers.val (𝟙 V : V ⟶ V).center 0=Part.none at hh
  rw [hh] at h0
  exact h0.1

theorem section_lifting : SectionLifting rangeFunctor U := by
  intro c c' hc
  exact inclusion.map_surjective
    (switchSection (rangeFunctor.mapIdem c) (rangeFunctor.mapIdem c')
      (rangeFunctor.map_complementary hc) ≫ (rangeFunctor.comparison U U).hom)

def pair0 : Idem U := diagonal0 turing sumFrame
def pair1 : Idem U := diagonal1 turing sumFrame

/-- The three-point example uses the actual checked evaluator and fullness
to discharge section lifting in Theorem 6.3. -/
theorem pair_inseparable : Inseparable pair0 pair1 :=
  range_functor_lifting rangeFunctor turing turing_isTuring sumFrame
    inclusion_nonzero section_lifting

end CategoricalEssentialIncompleteness.LocalConnectedness.EffectiveFork.Recursion
