module

public import CategoricalEssentialIncompleteness.V46SyntacticAxiomPredicates
public import CategoricalEssentialIncompleteness.V46SyntacticGeneratedTheory

/-! # The proof image generated by a Sigma-one axiom enumeration -/

@[expose] public section

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open FFL FFL.FirstOrder FFL.FirstOrder.Arithmetic FFL.Entailment
open CategoryTheory CategoryTheory.Limits
open CategoricalEssentialIncompleteness.V46.SyntacticPredicates
open CategoricalEssentialIncompleteness.V46.SyntacticLists
open CategoricalEssentialIncompleteness.V46.SyntacticSyntax
namespace CategoricalEssentialIncompleteness.V46.SyntacticGeneratedAxioms
open ConcreteNamedComparison
variable (T : ArithmeticTheory) [𝗣𝗔 ⪯ T]
variable (V : PredicateCategory T) (σ π : ℕ → PredicateCategory T) (d : ℕ)
local notation "S" => plainCategoricalSyntax T V σ π d

/-- No closure or derivability datum is supplied: the rule presentation
and its initial algebra are the constructed ones for this enumeration. -/
def proofs (Γ : Carrier) := SyntacticGeneratedTheory.proofAlgebra T V σ π d
  (SyntacticAxiomPredicates.axioms T V σ π d Γ)

def conclusion (Γ : Carrier) : (proofs T V σ π d Γ).a.left ⟶ (S).algebra.a.2 :=
  (proofs T V σ π d Γ).a.hom

def theoremCarrier (Γ : Carrier) : Carrier :=
  let Sent := literalSentenceCarrier T V σ π d
  let C := imageCarrier (chosenGraph T (conclusion T V σ π d Γ)).graph
  .mkSigma “word. !Sent.val word ∧ !C.val word”

/-- The literal source program is selected from the conclusion morphism; its functionality
does not require PA to prove T-totality. -/
def literalTheoremCarrier (Γ : Carrier) : Carrier :=
  SyntacticGeneratedTheory.literalSentencePredicate T V σ π d
    (SyntacticAxiomPredicates.axioms T V σ π d Γ)

/-- Nonlogical axiom instances enter the nullary constructor. -/
def axiomProof (Γ : Carrier) :
    @Quiver.Hom (PredicateCategory T) inferInstance
      (SyntacticAxiomPredicates.axiomCarrier T V σ π d Γ) (proofs T V σ π d Γ).a.left :=
  coprod.inr ≫ SyntacticDerivation.nullaryDerivation T
    ((S).logicalRules (SyntacticAxiomPredicates.axioms T V σ π d Γ))

theorem axiomProof_conclusion (Γ : Carrier) :
    axiomProof T V σ π d Γ ≫ conclusion T V σ π d Γ =
      SyntacticAxiomPredicates.axioms T V σ π d Γ ≫ (S).sentenceInclusion := by
  dsimp only [axiomProof,conclusion,proofs,SyntacticGeneratedTheory.proofAlgebra]
  erw [Category.assoc,SyntacticDerivation.nullaryDerivation_conclusion]
  exact coprod.inr_desc _ _

section Models
variable (M : Type) [ORingStructure M] [M↓[ℒₒᵣ] ⊧* T]

/-- Typed model points witness the image of any represented morphism. -/
theorem imageCarrier_points {A B : PredicateCategory T} (f : A ⟶ B) (word : M) :
    (imageCarrier (chosenGraph T f).graph).val.Evalb ![word] ↔
      ∃ a : Obj T M A, ((F T M).map f a).val = word := by
  rw [imageCarrier_eval]
  constructor
  · rintro ⟨a,ha⟩
    let aa : Obj T M A := ⟨a,((chosenGraph T f).support_model M a word ha).1⟩
    let w : Obj T M B := ⟨word,((chosenGraph T f).support_model M a word ha).2⟩
    exact ⟨aa,congrArg Subtype.val ((chosenGraph_map_iff T M f aa w).mp ha)⟩
  · rintro ⟨a,ha⟩
    have hg := (chosenGraph_map_iff T M f a ((F T M).map f a)).mpr rfl
    exact ⟨a.val,by simpa only [ha] using hg⟩

/-- Image membership has a typed proof point as witness, including at nonstandard words in
arbitrary models of T. -/
theorem theoremCarrier_model (Γ : Carrier) (word : M) :
    (theoremCarrier T V σ π d Γ).val.Evalb ![word] ↔
      (literalSentenceCarrier T V σ π d).val.Evalb ![word] ∧
        ∃ p : Obj T M (proofs T V σ π d Γ).a.left,
          ((F T M).map (conclusion T V σ π d Γ) p).val = word := by
  simpa [theoremCarrier] using and_congr Iff.rfl
    (imageCarrier_points T M (conclusion T V σ π d Γ) word)

theorem literalTheoremCarrier_model (Γ : Carrier) (word : M) :
    (literalTheoremCarrier T V σ π d Γ).val.Evalb ![word] ↔
      (theoremCarrier T V σ π d Γ).val.Evalb ![word] := by
  let : M↓[ℒₒᵣ] ⊧* 𝗣𝗔 := models_of_subtheory (U := T) inferInstance
  change (SyntacticSentenceImages.programTheoryCarrier T
    (conclusion T V σ π d Γ) (S).sentenceInclusion).val.Evalb ![word] ↔ _
  rw [SyntacticSentenceImages.programTheoryCarrier_theory,
    SyntacticSentenceImages.theoryCarrier_eval,sentenceCarrier_literal T V σ π d M]
  simp [theoremCarrier]

/-- Every enumerated sentence has a finite derivation witness; this uses the constructed
axiom morphism and nullary proof constructor. -/
theorem axiomProof_value (Γ : Carrier)
    (a : Obj T M (SyntacticAxiomPredicates.axiomCarrier T V σ π d Γ)) :
    ((F T M).map (conclusion T V σ π d Γ)
      ((F T M).map (axiomProof T V σ π d Γ) a)).val = a.val := by
  rw [← Functor.map_comp_apply,axiomProof_conclusion]
  exact SyntacticAxiomPredicates.axioms_formula_value T V σ π d M Γ a

end Models

def theoremProgramSentence (Γ : Carrier) : ArithmeticSentence :=
  let A := literalTheoremCarrier T V σ π d Γ
  let B := theoremCarrier T V σ π d Γ
  “∀ word, !A.val word ↔ !B.val word”

theorem theoremProgram_theory (Γ : Carrier) : T ⊢ theoremProgramSentence T V σ π d Γ := by
  apply complete.{0} T
  intro M _ _
  simpa [models_iff,theoremProgramSentence] using
    (fun word : M => literalTheoremCarrier_model T V σ π d M Γ word)

end CategoricalEssentialIncompleteness.V46.SyntacticGeneratedAxioms
