import FailureOfComposition.NativeInternalSyntax

/-!
# Structural arithmetization of the native proof checker

The history used here is an internal HFS sequence of bits, not a Lean list.
`historyAccept h d` reads position `d` with Foundation's zero-default `znth`.
The rule predicate then follows the ten constructors of the accepted numerical
checker.  Its axiom leaf uses a relative Sigma-one graph whose coordinates are
`(bit, formulaCode)`.

The table is generated by an internal primitive recursion.  It starts with
the empty sequence, appends the bit computed at the current index, and the
public derivation checker reads position `d` from the table at `d+1`.
-/

set_option autoImplicit false

open Encodable FFL FFL.FirstOrder FFL.FirstOrder.Arithmetic
open scoped FFL.FirstOrder.Arithmetic

namespace FailureOfComposition.NativeInternalChecker

open FFL.FirstOrder.Arithmetic.Bootstrapping
open FailureOfComposition.NativeContextMP
open FailureOfComposition.NativeSubstitution
open FailureOfComposition.NativeSyntaxShift
open FailureOfComposition.NativeProofChecker
open FailureOfComposition.NativeInternalSyntax

/-! ## Relative rule predicate -/

/-- Position `d` of the internal history sequence is the accepting bit. -/
def historyAccept
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    (h d : V) : Prop := znth h d = 1

/-- Delta-one presentation of `historyAccept`, with coordinates `(history,
index)`. -/
noncomputable def historyAcceptDelta : 𝚫₁.Semisentence 2 := .mkDelta
  (.mkSigma “h d. ∃ b, !znthDef b h d ∧ b = 1”)
  (.mkPi “h d. ∀ b, !znthDef b h d → b = 1”)

theorem historyAcceptDelta_sigma_iff
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    (h d : V) :
    Semiformula.Evalb (M := V) ![h, d]
        historyAcceptDelta.sigma.val ↔ historyAccept h d := by
  simp [historyAcceptDelta, historyAccept]

theorem historyAcceptDelta_pi_iff
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    (h d : V) :
    Semiformula.Evalb (M := V) ![h, d]
        historyAcceptDelta.pi.val ↔ historyAccept h d := by
  simp [historyAcceptDelta, historyAccept]

/-- The structural ten-case rule predicate.  Every code and history index is
an element of the ambient PA model. -/
noncomputable def ruleAccept
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    (A : 𝚺₁.Semisentence 2) (h d : V) : Prop :=
  IsFormulaSet ℒₒᵣ (fstIdx d) ∧
  ((∃ s < d, ∃ p < d, d = axL s p ∧ IsFormula ℒₒᵣ p ∧
      p ∈ s ∧ guardedNegValue p ∈ s) ∨
   (∃ s < d, d = verumIntro s ∧ ^⊤ ∈ s) ∨
   (∃ s < d, ∃ p < d, ∃ q < d, ∃ dp < d, ∃ dq < d, d = andIntro s p q dp dq ∧ p ^⋏ q ∈ s ∧
      (fstIdx dp = insert p s ∧ historyAccept h dp) ∧
      (fstIdx dq = insert q s ∧ historyAccept h dq)) ∨
   (∃ s < d, ∃ p < d, ∃ q < d, ∃ dc < d, d = orIntro s p q dc ∧ p ^⋎ q ∈ s ∧
      fstIdx dc = insert p (insert q s) ∧ historyAccept h dc) ∨
   (∃ s < d, ∃ p < d, ∃ dc < d, d = allIntro s p dc ∧ IsSemiformula ℒₒᵣ 1 p ∧
      ^∀ p ∈ s ∧
      fstIdx dc = insert (formulaFreeValue p) (sequentShiftValue s) ∧
      historyAccept h dc) ∨
   (∃ s < d, ∃ p < d, ∃ t < d, ∃ dc < d, d = exsIntro s p t dc ∧
      IsSemiformula ℒₒᵣ 1 p ∧ IsSemiterm ℒₒᵣ 0 t ∧
      ^∃ p ∈ s ∧ fstIdx dc = insert (subst1Value t p) s ∧
      historyAccept h dc) ∨
   (∃ s < d, ∃ dc < d, d = wkRule s dc ∧ fstIdx dc ⊆ s ∧
      historyAccept h dc) ∨
   (∃ s < d, ∃ dc < d, d = shiftRule s dc ∧
      s = sequentShiftValue (fstIdx dc) ∧ historyAccept h dc) ∨
   (∃ s < d, ∃ p < d, ∃ d₁ < d, ∃ d₂ < d, d = cutRule s p d₁ d₂ ∧ IsFormula ℒₒᵣ p ∧
      (fstIdx d₁ = insert p s ∧ historyAccept h d₁) ∧
      (fstIdx d₂ = insert (guardedNegValue p) s ∧ historyAccept h d₂)) ∨
   (∃ s < d, ∃ p < d, d = axm s p ∧ p ∈ s ∧
      Semiformula.Evalb (M := V) ![1, p] A.val))

private theorem axiom_one_iff_not_zero
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A)
    (a : V) :
    Semiformula.Evalb (M := V) ![1, a] A.val ↔
      ¬Semiformula.Evalb (M := V) ![0, a] A.val := by
  constructor
  · intro h₁ h₀
    have : (1 : V) = 0 := (hA.existsUnique a).unique h₁ h₀
    simp at this
  · intro h₀
    rcases hA.existsUnique a with ⟨b, hb, _⟩
    rcases hA.bit hb with (rfl | rfl)
    · exact False.elim (h₀ hb)
    · exact hb

/-- Relative Delta-one presentation of the ten cases.  The Sigma side uses
the accepting axiom bit; the Pi side uses nonacceptance of bit zero. -/
noncomputable def ruleAcceptDelta (A : 𝚺₁.Semisentence 2) :
    𝚫₁.Semisentence 2 := .mkDelta
  (.mkSigma “h d.
    (∃ fst, !fstIdxDef fst d ∧ !(isFormulaSet ℒₒᵣ).sigma fst) ∧
    ((∃ s < d, ∃ p < d, !axLGraph d s p ∧ !(isSemiformula ℒₒᵣ).sigma 0 p ∧
        p ∈ s ∧ ∃ np, !guardedNegGraph np p ∧ np ∈ s) ∨
     (∃ s < d, !verumIntroGraph d s ∧ ∃ vrm, !qqVerumDef vrm ∧ vrm ∈ s) ∨
     (∃ s < d, ∃ p < d, ∃ q < d, ∃ dp < d, ∃ dq < d, !andIntroGraph d s p q dp dq ∧
        (∃ apq, !qqAndDef apq p q ∧ apq ∈ s) ∧
        (∃ c, !fstIdxDef c dp ∧ !insertDef c p s ∧
          !historyAcceptDelta.sigma h dp) ∧
        (∃ c, !fstIdxDef c dq ∧ !insertDef c q s ∧
          !historyAcceptDelta.sigma h dq)) ∨
     (∃ s < d, ∃ p < d, ∃ q < d, ∃ dc < d, !orIntroGraph d s p q dc ∧
        (∃ opq, !qqOrDef opq p q ∧ opq ∈ s) ∧
        ∃ c, !fstIdxDef c dc ∧ ∃ cq, !insertDef cq q s ∧
          !insertDef c p cq ∧ !historyAcceptDelta.sigma h dc) ∨
     (∃ s < d, ∃ p < d, ∃ dc < d, !allIntroGraph d s p dc ∧
        !(isSemiformula ℒₒᵣ).sigma 1 p ∧
        (∃ ap, !qqAllDef ap p ∧ ap ∈ s) ∧
        ∃ c, !fstIdxDef c dc ∧ ∃ fp, !formulaFreeGraph fp p ∧
        ∃ ss, !sequentShiftGraph ss s ∧
          !insertDef c fp ss ∧ !historyAcceptDelta.sigma h dc) ∨
     (∃ s < d, ∃ p < d, ∃ t < d, ∃ dc < d, !exsIntroGraph d s p t dc ∧
        !(isSemiformula ℒₒᵣ).sigma 1 p ∧
        !(isSemiterm ℒₒᵣ).sigma 0 t ∧
        (∃ ep, !qqExsDef ep p ∧ ep ∈ s) ∧
        ∃ c, !fstIdxDef c dc ∧ ∃ pt, !subst1Graph pt t p ∧
          !insertDef c pt s ∧ !historyAcceptDelta.sigma h dc) ∨
     (∃ s < d, ∃ dc < d, !wkRuleGraph d s dc ∧ ∃ c, !fstIdxDef c dc ∧
        !bitSubsetDef c s ∧ !historyAcceptDelta.sigma h dc) ∨
     (∃ s < d, ∃ dc < d, !shiftRuleGraph d s dc ∧ ∃ c, !fstIdxDef c dc ∧
        !sequentShiftGraph s c ∧ !historyAcceptDelta.sigma h dc) ∨
     (∃ s < d, ∃ p < d, ∃ d₁ < d, ∃ d₂ < d, !cutRuleGraph d s p d₁ d₂ ∧
        !(isSemiformula ℒₒᵣ).sigma 0 p ∧
        (∃ c, !fstIdxDef c d₁ ∧ !insertDef c p s ∧
          !historyAcceptDelta.sigma h d₁) ∧
        (∃ c, !fstIdxDef c d₂ ∧ ∃ np, !guardedNegGraph np p ∧
          !insertDef c np s ∧ !historyAcceptDelta.sigma h d₂)) ∨
     (∃ s < d, ∃ p < d, !axmGraph d s p ∧ p ∈ s ∧ !A.val 1 p))”)
  (.mkPi “h d.
    (∀ fst, !fstIdxDef fst d → !(isFormulaSet ℒₒᵣ).pi fst) ∧
    ((∃ s < d, ∃ p < d, !axLGraph d s p ∧ !(isSemiformula ℒₒᵣ).pi 0 p ∧
        p ∈ s ∧ ∀ np, !guardedNegGraph np p → np ∈ s) ∨
     (∃ s < d, !verumIntroGraph d s ∧ ∀ vrm, !qqVerumDef vrm → vrm ∈ s) ∨
     (∃ s < d, ∃ p < d, ∃ q < d, ∃ dp < d, ∃ dq < d, !andIntroGraph d s p q dp dq ∧
        (∀ apq, !qqAndDef apq p q → apq ∈ s) ∧
        (∀ c, !fstIdxDef c dp → !insertDef c p s ∧
          !historyAcceptDelta.pi h dp) ∧
        (∀ c, !fstIdxDef c dq → !insertDef c q s ∧
          !historyAcceptDelta.pi h dq)) ∨
     (∃ s < d, ∃ p < d, ∃ q < d, ∃ dc < d, !orIntroGraph d s p q dc ∧
        (∀ opq, !qqOrDef opq p q → opq ∈ s) ∧
        ∀ c, !fstIdxDef c dc → ∀ cq, !insertDef cq q s →
          !insertDef c p cq ∧ !historyAcceptDelta.pi h dc) ∨
     (∃ s < d, ∃ p < d, ∃ dc < d, !allIntroGraph d s p dc ∧
        !(isSemiformula ℒₒᵣ).pi 1 p ∧
        (∀ ap, !qqAllDef ap p → ap ∈ s) ∧
        ∀ c, !fstIdxDef c dc → ∀ fp, !formulaFreeGraph fp p →
        ∀ ss, !sequentShiftGraph ss s →
          !insertDef c fp ss ∧ !historyAcceptDelta.pi h dc) ∨
     (∃ s < d, ∃ p < d, ∃ t < d, ∃ dc < d, !exsIntroGraph d s p t dc ∧
        !(isSemiformula ℒₒᵣ).pi 1 p ∧
        !(isSemiterm ℒₒᵣ).pi 0 t ∧
        (∀ ep, !qqExsDef ep p → ep ∈ s) ∧
        ∀ c, !fstIdxDef c dc → ∀ pt, !subst1Graph pt t p →
          !insertDef c pt s ∧ !historyAcceptDelta.pi h dc) ∨
     (∃ s < d, ∃ dc < d, !wkRuleGraph d s dc ∧ ∀ c, !fstIdxDef c dc →
        !bitSubsetDef c s ∧ !historyAcceptDelta.pi h dc) ∨
     (∃ s < d, ∃ dc < d, !shiftRuleGraph d s dc ∧ ∀ c, !fstIdxDef c dc →
        ∀ ss, !sequentShiftGraph ss c →
          s = ss ∧ !historyAcceptDelta.pi h dc) ∨
     (∃ s < d, ∃ p < d, ∃ d₁ < d, ∃ d₂ < d, !cutRuleGraph d s p d₁ d₂ ∧
        !(isSemiformula ℒₒᵣ).pi 0 p ∧
        (∀ c, !fstIdxDef c d₁ → !insertDef c p s ∧
          !historyAcceptDelta.pi h d₁) ∧
        (∀ c, !fstIdxDef c d₂ → ∀ np, !guardedNegGraph np p →
          !insertDef c np s ∧ !historyAcceptDelta.pi h d₂)) ∨
     (∃ s < d, ∃ p < d, !axmGraph d s p ∧ p ∈ s ∧ ¬!A.val 0 p))”)

theorem ruleAcceptDelta_sigma_iff
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    (A : 𝚺₁.Semisentence 2)
    (h d : V) :
    Semiformula.Evalb (M := V) ![h, d]
        (ruleAcceptDelta A).sigma.val ↔ ruleAccept A h d := by
  simp [ruleAcceptDelta, ruleAccept, historyAcceptDelta_sigma_iff,
    formulaFreeGraph_iff, sequentShiftGraph_iff, guardedNegGraph_iff,
    subst1Graph_iff]

theorem ruleAcceptDelta_pi_iff
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A)
    (h d : V) :
    Semiformula.Evalb (M := V) ![h, d]
        (ruleAcceptDelta A).pi.val ↔ ruleAccept A h d := by
  simp [ruleAcceptDelta, ruleAccept, historyAcceptDelta_pi_iff,
    formulaFreeGraph_iff, sequentShiftGraph_iff, guardedNegGraph_iff,
    subst1Graph_iff, axiom_one_iff_not_zero hA]

/-- The internal rule-computation bit. -/
noncomputable def ruleCheckValue
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    (A : 𝚺₁.Semisentence 2) (h d : V) : V :=
  @ite V (ruleAccept A h d) (Classical.propDecidable _) 1 0

/-- Output-first Sigma-one graph `(bit,history,derivationCode)` of one table
step. -/
noncomputable def ruleCheckGraph (A : 𝚺₁.Semisentence 2) :
    𝚺₁.Semisentence 3 := .mkSigma
  “b h d.
    (b = 1 ∧ !(ruleAcceptDelta A).sigma h d) ∨
    (b = 0 ∧ ¬!(ruleAcceptDelta A).pi h d)”

theorem ruleCheckGraph_iff
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A)
    (b h d : V) :
    Semiformula.Evalb (M := V) ![b, h, d]
        (ruleCheckGraph A).val ↔ b = ruleCheckValue A h d := by
  by_cases hr : ruleAccept A h d <;>
    simp [ruleCheckGraph, ruleCheckValue, ruleAcceptDelta_sigma_iff,
      ruleAcceptDelta_pi_iff hA, hr]

theorem ruleCheckGraph_total
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A)
    (h d : V) :
    ∃ b : V, Semiformula.Evalb (M := V) ![b, h, d]
      (ruleCheckGraph A).val :=
  ⟨ruleCheckValue A h d, (ruleCheckGraph_iff hA _ _ _).mpr rfl⟩

theorem ruleCheckGraph_functional
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A)
    {b c h d : V}
    (hb : Semiformula.Evalb (M := V) ![b, h, d]
      (ruleCheckGraph A).val)
    (hc : Semiformula.Evalb (M := V) ![c, h, d]
      (ruleCheckGraph A).val) : b = c :=
  (ruleCheckGraph_iff hA b h d).mp hb |>.trans
    ((ruleCheckGraph_iff hA c h d).mp hc).symm

theorem ruleCheckValue_isBit
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    (A : 𝚺₁.Semisentence 2) (h d : V) :
    ruleCheckValue A h d = 0 ∨ ruleCheckValue A h d = 1 := by
  by_cases hr : ruleAccept A h d <;> simp [ruleCheckValue, hr]

/-! ## Internal table recursion -/

namespace Table

/-- The recursion starts at the empty HFS sequence and appends the rule bit
computed at the current index. -/
noncomputable def blueprint (A : 𝚺₁.Semisentence 2) : PR.Blueprint 0 where
  zero := .mkSigma “y. y = 0”
  succ := .mkSigma “y ih k. ∃ b, !(ruleCheckGraph A).val b ih k ∧
    !seqConsDef y ih b”

noncomputable def construction
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A) :
    PR.Construction V (blueprint A) where
  zero _ := 0
  succ _ k ih := ih ⁀' ruleCheckValue A ih k
  zero_defined := .mk fun v ↦ by simp [blueprint]
  succ_defined := .mk fun v ↦ by
    simp [blueprint, ruleCheckGraph_iff hA]

end Table

/-- The internal table after `n` recurrence steps. -/
noncomputable def checkTableValue
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A)
    (n : V) : V :=
  (Table.construction hA).result ![] n

/-- Output-first table graph `(table,length)`. -/
noncomputable def checkTableGraph (A : 𝚺₁.Semisentence 2) :
    𝚺₁.Semisentence 2 :=
  (Table.blueprint A).resultDef

theorem checkTableGraph_iff
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A)
    (t n : V) :
    Semiformula.Evalb (M := V) ![t, n] (checkTableGraph A).val ↔
      t = checkTableValue hA n := by
  simpa [checkTableGraph, checkTableValue,
    show (fun _ : Fin 0 => n) = (![] : Fin 0 → V) from
      funext fun i => i.elim0] using
    (Table.construction hA).result_defined_iff ![t, n]

private theorem checkTableValue_defined
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A) :
    𝚺₁-Function₁[V] (checkTableValue hA) via checkTableGraph A :=
  .mk fun v => by
    have hv : v = ![v 0, v 1] := by ext i; fin_cases i <;> rfl
    rw [hv]
    exact checkTableGraph_iff hA (v 0) (v 1)

private instance checkTableValue_definable
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A) :
    𝚺₁-Function₁[V] (checkTableValue hA) :=
  (checkTableValue_defined hA).to_definable

private instance checkTableValue_definable_delta
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A) :
    𝚫₁-Function₁[V] (checkTableValue hA) :=
  (checkTableValue_defined hA).graph_delta.to_definable

private instance checkTableValue_definable_hierarchy
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A)
    (Γ m) : Γ-[m + 1]-Function₁[V] (checkTableValue hA) :=
  (checkTableValue_definable hA).of_sigmaOne

theorem checkTableValue_zero
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A) :
    checkTableValue hA 0 = 0 := by
  simp [checkTableValue, Table.construction]

theorem checkTableValue_succ
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A)
    (n : V) :
    checkTableValue hA (n + 1) =
      checkTableValue hA n ⁀' ruleCheckValue A (checkTableValue hA n) n := by
  simp [checkTableValue, Table.construction]

theorem checkTableGraph_total
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A)
    (n : V) :
    ∃ t : V, Semiformula.Evalb (M := V) ![t, n]
      (checkTableGraph A).val :=
  ⟨checkTableValue hA n, (checkTableGraph_iff hA _ _).mpr rfl⟩

theorem checkTableGraph_functional
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A)
    {t u n : V}
    (ht : Semiformula.Evalb (M := V) ![t, n]
      (checkTableGraph A).val)
    (hu : Semiformula.Evalb (M := V) ![u, n]
      (checkTableGraph A).val) : t = u :=
  (checkTableGraph_iff hA t n).mp ht |>.trans
    ((checkTableGraph_iff hA u n).mp hu).symm

theorem checkTableValue_seq_length
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A)
    (n : V) :
    Seq (checkTableValue hA n) ∧ lh (checkTableValue hA n) = n := by
  induction n using ISigma1.sigma1_succ_induction
  · definability
  case zero =>
    rw [checkTableValue_zero]
    simpa only [emptyset_def] using
      (show Seq (∅ : V) ∧ lh (∅ : V) = 0 from ⟨seq_empty, lh_empty⟩)
  case succ n ih =>
    rw [checkTableValue_succ]
    exact ⟨ih.1.seqCons _, by simp [ih]⟩

private theorem znth_append_last
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {s : V} (hs : Seq s) (x : V) : znth (s ⁀' x) (lh s) = x :=
  (hs.seqCons x).znth_eq_of_mem (lh_mem_seqCons s x)

private theorem znth_append_lt
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {s i : V} (hs : Seq s) (x : V) (hi : i < lh s) :
    znth (s ⁀' x) i = znth s i :=
  (hs.seqCons x).znth_eq_of_mem
    (Seq.mem_seqCons_iff_of_lt hi |>.mpr (hs.znth hi))

/-- Appending the entry at `n` preserves every earlier lookup. -/
theorem checkTableValue_lookup_lt
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A)
    {i n : V} (hi : i < n) :
    znth (checkTableValue hA (n + 1)) i = znth (checkTableValue hA n) i := by
  rw [checkTableValue_succ]
  exact znth_append_lt (checkTableValue_seq_length hA n).1 _
    (by simpa [(checkTableValue_seq_length hA n).2] using hi)

/-- The last lookup reads the bit just computed at `n`. -/
theorem checkTableValue_lookup_last
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A)
    (n : V) :
    znth (checkTableValue hA (n + 1)) n = ruleCheckValue A (checkTableValue hA n) n := by
  rw [checkTableValue_succ]
  simpa only [(checkTableValue_seq_length hA n).2] using
    znth_append_last (checkTableValue_seq_length hA n).1
      (ruleCheckValue A (checkTableValue hA n) n)

/-- Every generated entry is a Boolean bit.  The induction is internal and
uses the arithmetic definition of the table function. -/
theorem checkTableValue_bits
    {V : Type*} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗣𝗔]
    {A : 𝚺₁.Semisentence 2} (hA : ComputationalAxiomGraph (V := V) A)
    (n : V) :
    ∀ i < n, znth (checkTableValue hA n) i = 0 ∨
      znth (checkTableValue hA n) i = 1 := by
  induction n using ISigma1.sigma1_succ_induction
  · definability
  case zero => simp
  case succ n ih =>
    intro i hi
    rcases lt_or_eq_of_le (lt_succ_iff_le.mp hi) with (hi | rfl)
    · rw [checkTableValue_lookup_lt hA hi]
      exact ih i hi
    · rw [checkTableValue_lookup_last]
      exact ruleCheckValue_isBit A _ _

end FailureOfComposition.NativeInternalChecker
