example (S : ArithmeticTheory) [S.Δ₁] : acceptanceFormula S =
    .mkSigma “p c. !(nativeProofCheckGraph (canonicalAxiomGraph S)) 1 p c” := rfl

example (S : ArithmeticTheory) [S.Δ₁] (M : 𝚺₁.Semisentence 1) (h k : ℕ) :
    familyAcceptance S M h k =
      .mkSigma “e. !(acceptanceFormula S) e ↑(Encodable.encode (familyEq M h k))” := rfl

example (S : ArithmeticTheory) [S.Δ₁] (h : ℕ) : membershipFormula S h =
    .mkSigma “u d. ∃ y, !(outputGraph h) u y ∧
      ∃ p, !(nativeEqCheckFormula (canonicalAxiomGraph S)) p y d” := rfl

example (M : 𝚺₁.Semisentence 1) (k : ℕ) : totality M k =
    (“∀ u, !M u → ∃ r, !(outputGraph k) u r” : ArithmeticSentence) := rfl

example (S : ArithmeticTheory) [S.Δ₁] (M : 𝚺₁.Semisentence 1) (h k : ℕ) :
    transferBody S M h k =
      (“u d. !M u → !(membershipFormula S h) u d → !(membershipFormula S k) u d” :
        ArithmeticSemisentence 2) := rfl

example (S : ArithmeticTheory) [S.Δ₁] (M : 𝚺₁.Semisentence 1) (h k : ℕ) :
    pointwiseSchema S M h k = ∀¹ ∀¹ ∀¹ pointwiseMatrixFor
      (familyAcceptance S M h k).val (totality M k) M.val
      (membershipFormula S h).val (membershipFormula S k).val := rfl

example (S : ArithmeticTheory) [S.Δ₁] (M : 𝚺₁.Semisentence 1) (h k : ℕ) :
    closureSchema S M h k = ∀¹ ∀¹ closureMatrixFor
      (familyAcceptance S M h k).val (totality M k) (transferClosure S M h k) := rfl

end NativeMembershipAssemblyChecks

