section ProductionStageTypes

open FFL.FirstOrder.Arithmetic Metamath.Feferman
open Arith.Feferman.Specialization FailureOfComposition.NumericalProofBridge
open FailureOfComposition.UniformIndexQuotient FailureOfComposition.ProofSearchMembership
open FailureOfComposition.ProductionStageClosure

example (w : ℕ → ℕ → Bool) {p q r : ℕ}
    (hp : Proof_T (extendedTheoryPresentation w) p (equalityCode q r)) :
    q = r ∨ ∃ s ≤ p, w (eqSentenceCode q r) s = true :=
  proof_T_equality_stage_bound w hp

example (T : ArithmeticTheory) (hRE : REPred (FailureOfComposition.AxiomCodes T))
    (bound : PrfEqTransportArgs → ℕ) :
    StageTransportBoundCorrect T hRE bound ↔
      ∀ e p y y' d : ℕ, PrfEq T hRE e y y' → PrfEq T hRE p y d →
        y' = d ∨ ∃ s ≤ bound ((((e, p), y), y'), d),
          reTheoryStageWitness T hRE (eqSentenceCode y' d) s = true := Iff.rfl

example (T : ArithmeticTheory) (hRE : REPred (FailureOfComposition.AxiomCodes T)) :
    HasPrimitiveRecursivePrfEqTransport T hRE ↔
      ∃ bound : PrfEqTransportArgs → ℕ, Primrec bound ∧
        StageTransportBoundCorrect T hRE bound :=
  has_transport_iff_stage_bound T hRE

example : ¬∃ bound : ℕ → ℕ, Primrec bound ∧ ∀ n, ∃ s ≤ bound n,
    FailureOfComposition.StageEnumerationObstruction.delayedStage n s = true :=
  FailureOfComposition.StageEnumerationObstruction.no_primrec_stage_bound

end ProductionStageTypes
