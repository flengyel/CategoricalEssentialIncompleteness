/-- The production endpoint is frozen to the original extended presentation. -/
example (T : ArithmeticTheory)
    (hRE : REPred (FailureOfComposition.AxiomCodes T))
    (p q r : ℕ) :
    PrfEq T hRE p q r ↔
      Proof_T (reTheoryExtendedTheoryPresentation T hRE)
        p (equalityCode q r) :=
  Iff.rfl

/-- The repair endpoint is frozen to the additive presentation, rather than
the production presentation above. -/
example (T : ArithmeticTheory)
    (hRE : REPred (FailureOfComposition.AxiomCodes T))
    (p q r : ℕ) :
    RepairPrfEq T hRE p q r ↔
      Proof_T (reTheoryTransportRepairPresentation T hRE)
        p (equalityCode q r) :=
  Iff.rfl

/-- This is the unproved production-checker specification, not a completion
theorem. -/
example (T : ArithmeticTheory)
    (hRE : REPred (FailureOfComposition.AxiomCodes T)) :
    HasPrimitiveRecursivePrfEqTransport T hRE ↔
      ∃ transport : PrfEqTransportArgs → ℕ,
        Primrec transport ∧
          ∀ e p y y' d : ℕ,
            PrfEq T hRE e y y' →
              PrfEq T hRE p y d →
                PrfEq T hRE
                  (transport ((((e, p), y), y'), d)) y' d :=
  Iff.rfl

/-- The proved packed theorem has the same five numerical inputs but uses the
separately named repair checker in both premises and the conclusion. -/
example (T : ArithmeticTheory)
    (hRE : REPred (FailureOfComposition.AxiomCodes T)) :
    ∀ e p y y' d : ℕ,
      RepairPrfEq T hRE e y y' →
        RepairPrfEq T hRE p y d →
          RepairPrfEq T hRE
            (transportPacked ((((e, p), y), y'), d)) y' d :=
  transportPacked_correct_repair T hRE

/-- The proved reverse compatibility statement is existential and standard;
it is not the following unproved effective specification. -/
example (T : ArithmeticTheory)
    (hRE : REPred (FailureOfComposition.AxiomCodes T)) :
    HasPrimitiveRecursiveRepairBacktranslation T hRE ↔
      ∃ back : ℕ → ℕ,
        Primrec back ∧
          ∀ p q r : ℕ,
            RepairPrfEq T hRE p q r → PrfEq T hRE (back p) q r :=
  Iff.rfl

example (T : ArithmeticTheory) [𝗣𝗔 ⪯ T]
    (hRE : REPred (FailureOfComposition.AxiomCodes T))
    {p q r : ℕ} :
    RepairPrfEq T hRE p q r → ∃ p' : ℕ, PrfEq T hRE p' q r :=
  repairPrfEq_to_exists_prfEq T hRE

/-- The preservation result universally closes the nine-variable matrix; its
matrix definition fixes both repair-proof premises, the three indices, the
three equality codes, the transport graph, and the repair-proof conclusion. -/
private noncomputable def expectedTransportPreservationMatrix
    (w : ℕ → ℕ → Bool)
    (hw : Primrec (fun z : ℕ × ℕ => w z.1 z.2)) :
    ArithmeticSemisentence 9 :=
  let prf := transportRepairProofGraph w hw
  “e p y z d a b c t.
    !equalityCodeGraph a y z ∧
    !equalityCodeGraph b y d ∧
    !equalityCodeGraph c z d ∧
    !prf e a ∧
    !prf p b ∧
    !transportGraph t e p y z d →
    !prf t c”

example (w : ℕ → ℕ → Bool)
    (hw : Primrec (fun z : ℕ × ℕ => w z.1 z.2)) :
    transportPreservationMatrix w hw =
      expectedTransportPreservationMatrix w hw :=
  rfl

example (w : ℕ → ℕ → Bool)
    (hw : Primrec (fun z : ℕ × ℕ => w z.1 z.2)) :
    𝗣𝗔 ⊢ ∀¹* transportPreservationMatrix w hw :=
  provable_PA_uniformTransportPreservation w hw

