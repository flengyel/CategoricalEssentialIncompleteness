module

public import Mathlib.CategoryTheory.Widesubcategory
public import PCats.PCat

/-!
# Heller's projection-generated subcategory

Appendix A, lines 58–62; Heller, pp. 1260–1261. `P` is the smallest subcategory
closed under the near product and containing every `p₀` and `p₁`. Here it is
the morphism property `PCategory.projectionGenerated`, generated by identities,
the projections, composition, and `nearProd_map`, with
`PCategory.projectionGenerated_le` as its leastness among multiplicative
properties closed under those generators. The diagonal is not a generator.

`PCategory.ProjectionSubcategory` is the corresponding wide subcategory.

Under `PCategory`, every generated morphism is total, so the naturalizer
containments hold: `p0_nat_of_projectionGenerated` is `C × P ⊆ nat p₀` and
`p1_nat_of_projectionGenerated` is `P × C ⊆ nat p₁`. The coordinate
orientations differ — for `p₀` the second morphism is generated, for `p₁` the
first. `projectionGenerated_isTotal` is `P ⊆ C_T`; the reverse containment is
not proved.

The closure API assumes only `Category` and `PCategoryStruct`; totality and the
two naturality equations add `PCategory`.
-/

@[expose] public section

universe v u

namespace CategoryTheory

open PCategoryStruct

namespace PCategory

section Closure

variable {C : Type u} [Category.{v} C] [PCategoryStruct C]

/-- The generating closure: identities, the projections, composition, and the
near product. -/
inductive Gen : {X Y : C} → (X ⟶ Y) → Prop
  | id (X : C) : Gen (𝟙 X)
  | proj0 (X Y : C) : Gen (p0 X Y)
  | proj1 (X Y : C) : Gen (p1 X Y)
  | comp {X Y Z : C} {f : X ⟶ Y} {g : Y ⟶ Z} :
      Gen f → Gen g → Gen (f ≫ g)
  | prod {W X Y Z : C} {f : W ⟶ X} {g : Y ⟶ Z} :
      Gen f → Gen g → Gen (nearProd_map f g)

/-- Heller's `P`: the morphisms generated by the projections under composition
and the near product. -/
def projectionGenerated : MorphismProperty C := fun _ _ f => Gen f

lemma projectionGenerated_p0 (X Y : C) : projectionGenerated (p0 X Y) :=
  Gen.proj0 X Y

lemma projectionGenerated_p1 (X Y : C) : projectionGenerated (p1 X Y) :=
  Gen.proj1 X Y

lemma projectionGenerated_nearProd_map {W X Y Z : C} {f : W ⟶ X} {g : Y ⟶ Z}
    (hf : projectionGenerated f) (hg : projectionGenerated g) :
    projectionGenerated (nearProd_map f g) :=
  Gen.prod hf hg

instance instIsMultiplicativeProjectionGenerated :
    (projectionGenerated (C := C)).IsMultiplicative where
  id_mem X := Gen.id X
  comp_mem _ _ hf hg := Gen.comp hf hg

/-- The wide subcategory of projection-generated morphisms. -/
abbrev ProjectionSubcategory (C : Type u) [Category.{v} C]
    [PCategoryStruct C] :=
  WideSubcategory (projectionGenerated (C := C))

/-- Leastness: any multiplicative property containing the projections and
closed under the near product contains `projectionGenerated`. -/
theorem projectionGenerated_le (M : MorphismProperty C) [M.IsMultiplicative]
    (hp0 : ∀ X Y, M (p0 X Y)) (hp1 : ∀ X Y, M (p1 X Y))
    (hprod : ∀ {W X Y Z : C} {f : W ⟶ X} {g : Y ⟶ Z},
      M f → M g → M (nearProd_map f g)) :
    ∀ ⦃X Y : C⦄ (f : X ⟶ Y),
      projectionGenerated (C := C) f → M f := by
  intro X Y f hf
  have hf' : Gen f := hf
  clear hf
  induction hf' with
  | id X => exact M.id_mem X
  | proj0 X Y => exact hp0 X Y
  | proj1 X Y => exact hp1 X Y
  | comp _ _ ihf ihg => exact M.comp_mem _ _ ihf ihg
  | prod _ _ ihf ihg => exact hprod ihf ihg

end Closure

section Total

variable {C : Type u} [Category.{v} C] [PCategoryStruct C] [PCategory C]

/-- The two spellings of `rst`, bridged by definitional equality. -/
private lemma isTotal_of_rst {X Y : C} {f : X ⟶ Y} (h : rst f = 𝟙 X) :
    RestrictionCategory.isTotal f := h

private lemma rst_of_isTotal {X Y : C} {f : X ⟶ Y}
    (h : RestrictionCategory.isTotal f) : rst f = 𝟙 X := h

/-- `P ⊆ C_T`: every projection-generated morphism is total. -/
theorem projectionGenerated_isTotal {X Y : C} {f : X ⟶ Y}
    (hf : projectionGenerated f) : RestrictionCategory.isTotal f :=
  projectionGenerated_le RestrictionCategory.isTotal
    (fun X Y => isTotal_of_rst (p0_isTotal X Y))
    (fun X Y => isTotal_of_rst (p1_isTotal X Y))
    (fun hf hg => isTotal_of_rst
      (isTotal_nearProd_map (rst_of_isTotal hf) (rst_of_isTotal hg))) f hf

/-- `C × P ⊆ nat p₀`: the second morphism is projection-generated. -/
theorem p0_nat_of_projectionGenerated {W X Y Z : C} (f : W ⟶ X) {g : Y ⟶ Z}
    (hg : projectionGenerated g) :
    nearProd_map f g ≫ p0 X Z = p0 W Y ≫ f :=
  p0_nat_of_isTotal f (rst_of_isTotal (projectionGenerated_isTotal hg))

/-- `P × C ⊆ nat p₁`: the first morphism is projection-generated. -/
theorem p1_nat_of_projectionGenerated {W X Y Z : C} {f : W ⟶ X} (g : Y ⟶ Z)
    (hf : projectionGenerated f) :
    nearProd_map f g ≫ p1 X Z = p1 W Y ≫ g :=
  p1_nat_of_isTotal g (rst_of_isTotal (projectionGenerated_isTotal hf))

end Total

end PCategory

end CategoryTheory
