===== QueriesDisjointJoins =====
@CategoricalEssentialIncompleteness.LocalConnectedness.image_switch_eq : ∀ {C : Type u_3}
  [inst : CategoryTheory.Category.{u_1, u_3} C] [inst_1 : CategoryTheory.RestrictionCategory C]
  [inst_2 : CategoryTheory.Limits.HasZeroMorphisms C]
  [inst_3 : CategoricalEssentialIncompleteness.LocalConnectedness.RestrictionZero C]
  [inst_4 : CategoryTheory.CoprodStruct C] [inst_5 : CategoryTheory.HasCoproducts C]
  [inst_6 : CategoricalEssentialIncompleteness.LocalConnectedness.BinaryJoins C] {A : Type u_4}
  [inst_7 : CategoryTheory.Category.{u_2, u_4} A] [inst_8 : CategoryTheory.RestrictionCategory A]
  [inst_9 : CategoryTheory.Limits.HasZeroMorphisms A]
  [inst_10 : CategoricalEssentialIncompleteness.LocalConnectedness.RestrictionZero A]
  [inst_11 : CategoricalEssentialIncompleteness.LocalConnectedness.BinaryJoins A]
  [inst_12 : CategoryTheory.CoprodStruct A] [inst_13 : CategoryTheory.HasCoproducts A]
  [inst_14 : CategoricalEssentialIncompleteness.LocalConnectedness.RestrictionCoproducts A]
  [inst_15 : CategoricalEssentialIncompleteness.LocalConnectedness.Ranges C]
  [inst_16 : CategoricalEssentialIncompleteness.LocalConnectedness.Ranges A]
  [inst_17 : CategoricalEssentialIncompleteness.LocalConnectedness.Splits A]
  [inst_18 : CategoricalEssentialIncompleteness.LocalConnectedness.JoinInverse A]
  [inst_19 : CategoricalEssentialIncompleteness.LocalConnectedness.LocallyConnected A]
  [inst_20 : CategoricalEssentialIncompleteness.LocalConnectedness.WeakChoice A]
  (F : CategoricalEssentialIncompleteness.LocalConnectedness.RangeFunctor C A) {X : C}
  (c c' : CategoricalEssentialIncompleteness.LocalConnectedness.Idem X)
  (hc : CategoricalEssentialIncompleteness.LocalConnectedness.Complementary c c')
  (ℓ : X ⟶ CategoryTheory.CoprodStruct.coprod X X),
  CategoryTheory.CategoryStruct.comp c.hom ℓ =
      CategoryTheory.CategoryStruct.comp c.hom (CategoryTheory.CoprodStruct.i1 X X) →
    CategoryTheory.CategoryStruct.comp c'.hom ℓ =
        CategoryTheory.CategoryStruct.comp c'.hom (CategoryTheory.CoprodStruct.i0 X X) →
      F.toFunctor.map ℓ =
        CategoryTheory.CategoryStruct.comp
          (CategoricalEssentialIncompleteness.LocalConnectedness.switchSection (F.mapIdem c) (F.mapIdem c') ⋯)
          (F.comparison X X).hom
'CategoricalEssentialIncompleteness.LocalConnectedness.image_switch_eq' depends on axioms: [propext, Classical.choice]

