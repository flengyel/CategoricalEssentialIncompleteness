@CategoricalEssentialIncompleteness.V46.ArithmeticUltrapower.Checks.graph_value : ∀ {I : Type} (U : Ultrafilter I)
  {C D : CategoricalEssentialIncompleteness.V46.SyntacticPredicates.Carrier}
  (f : CategoricalEssentialIncompleteness.V46.SyntacticPredicates.GraphMorphism 𝗣𝗔 C D)
  (x : I → CategoricalEssentialIncompleteness.V46.PredicateInterpretation.Obj ℕ C),
  (FFL.FirstOrder.Semiformula.Evalb
      ![↑fun i => ↑(x i),
        ↑fun i => ↑(CategoricalEssentialIncompleteness.V46.PredicateInterpretation.value 𝗣𝗔 ℕ f (x i))])
    ↑f.graph
