  (CategoricalEssentialIncompleteness.Numerical.predicates.pull
          (CategoricalEssentialIncompleteness.ArithmeticSyntax.substitutionRow g))
        (CategoricalEssentialIncompleteness.NumericalPER.supportSubobject A ⋯) =
