    ∀ (x n : ℕ),
      CategoricalEssentialIncompleteness.ArithmeticSyntax.substitutionFunction
            (CategoricalEssentialIncompleteness.Numerical.natFunction g x) n ∈
          A ↔
        n ∈ B
