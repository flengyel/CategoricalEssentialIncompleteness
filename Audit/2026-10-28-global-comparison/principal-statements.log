CategoricalEssentialIncompleteness.SubobjectIdentification.presheafIso.{v, u, w, v', u'} {A : Type u}
  [CategoryTheory.Category.{v, u} A] {P : CategoricalEssentialIncompleteness.PredicateLattice A} {C : Type u'}
  [CategoryTheory.Category.{v', u'} C] [CategoryTheory.Limits.HasPullbacks C] {J : CategoryTheory.Functor A C}
  (η : CategoricalEssentialIncompleteness.SubobjectIdentification P J) :
  P.presheaf.comp CategoryTheory.uliftFunctor.{max u' v', w} ≅
    J.op.comp ((CategoryTheory.Subobject.functor C).comp CategoryTheory.uliftFunctor.{w, max u' v'})
CategoricalEssentialIncompleteness.EnrichedRestriction.domainSubobject_naturality.{v, u, w, v', u'} {V : Type u}
  [CategoryTheory.Category.{v, u} V] [CategoryTheory.Limits.HasFiniteLimits V] {O : Type w}
  {H : CategoricalEssentialIncompleteness.InternalHom V O}
  (R : CategoricalEssentialIncompleteness.EnrichedRestriction H) (products : R.Products)
  (P : CategoricalEssentialIncompleteness.InternalPredicates (R.totalHom products)) [R.Zeros] [R.DomainLattices]
  (j : CategoricalEssentialIncompleteness.InternalPredicateEmbedding (R.domainPredicates products) P) {C : Type u'}
  [CategoryTheory.Category.{v', u'} C] [CategoryTheory.Regular C] [CategoryTheory.FinitaryExtensive C]
  {J : CategoryTheory.Functor R.GlobalTotal C}
  (η : CategoricalEssentialIncompleteness.SubobjectIdentification (R.predicatesOnTotals products P) J) {X Y : O}
  (f : R.totalGlobalObject X ⟶ R.totalGlobalObject Y) (a : R.GlobalDomain Y) :
  (R.domainSubobject products P j η X) (R.globalDomainInverse f.hom a) =
    (CategoryTheory.Subobject.pullback (J.map f)).obj ((R.domainSubobject products P j η Y) a)
