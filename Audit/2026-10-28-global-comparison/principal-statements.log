CategoricalEssentialIncompleteness.EnrichedRestriction.categorical_essential_incompleteness.{v, u, w, v', u'}
  {V : Type u} [CategoryTheory.Category.{v, u} V] [CategoryTheory.Limits.HasFiniteLimits V] {O : Type w}
  {H : CategoricalEssentialIncompleteness.InternalHom V O}
  (R : CategoricalEssentialIncompleteness.EnrichedRestriction H) [R.Zeros] [R.DomainLattices] (products : R.Products)
  (P : CategoricalEssentialIncompleteness.InternalPredicates (R.totalHom products)) {C : Type u'}
  [CategoryTheory.Category.{v', u'} C] [CategoryTheory.Regular C] [CategoryTheory.FinitaryExtensive C]
  (J : CategoryTheory.Functor R.GlobalTotal C)
  (η : CategoricalEssentialIncompleteness.SubobjectIdentification (R.predicatesOnTotals products P) J)
  (D : CategoricalEssentialIncompleteness.InternalDiagonalData (R.domainPredicates products) P)
  (σ : D.RepresentationSection) (hU : CategoryTheory.CategoryStruct.id (R.globalObject D.U) ≠ 0)
  (q : CategoricalEssentialIncompleteness.BooleanPresentation (J.obj (R.totalGlobalObject D.S)))
  (hpos : (η.app (R.totalGlobalObject D.S)) D.positive = q.positive)
  (hneg : (η.app (R.totalGlobalObject D.S)) D.negative = q.negative)
  (r : CategoricalEssentialIncompleteness.BooleanQuotient q.algebra)
  (_preservesProducts :
    CategoryTheory.Limits.PreservesLimitsOfShape (CategoryTheory.Discrete CategoryTheory.Limits.WalkingPair) J)
  (consistent : (q.quotient r).Consistent)
  (represented : R.RepresentedQuotientFibers products P J η D.embedding D.S q r) : ¬(q.quotient r).Complete
CategoricalEssentialIncompleteness.EnrichedRestriction.categorical_boundCopair_not_regularEpi.{v, u, w, v', u'}
  {V : Type u} [CategoryTheory.Category.{v, u} V] [CategoryTheory.Limits.HasFiniteLimits V] {O : Type w}
