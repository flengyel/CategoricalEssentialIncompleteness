@CategoricalEssentialIncompleteness.SubobjectPredicates.image_of_factorization : ∀ {C : Type u_2}
  [inst : CategoryTheory.Category.{u_1, u_2} C] [inst_1 : CategoryTheory.Limits.HasImages C] {X Y : C} {f : X ⟶ Y}
  (F : CategoryTheory.Limits.StrongEpiMonoFactorisation f),
  CategoryTheory.Limits.imageSubobject f = CategoryTheory.Subobject.mk F.m
@CategoricalEssentialIncompleteness.SubobjectPredicates.image_pullback : ∀ {C : Type u_2}
  [inst : CategoryTheory.Category.{u_1, u_2} C] [inst_1 : CategoryTheory.Regular C] {P X A Y : C} {p : P ⟶ X}
  {q : P ⟶ A} {f : X ⟶ Y} {g : A ⟶ Y},
  CategoryTheory.IsPullback p q f g →
    CategoryTheory.Limits.imageSubobject p =
      (CategoryTheory.Subobject.pullback f).obj (CategoryTheory.Limits.imageSubobject g)
@CategoricalEssentialIncompleteness.SubobjectPredicates.pullback_sup : ∀ {C : Type u_2}
  [inst : CategoryTheory.Category.{u_1, u_2} C] [inst_1 : CategoryTheory.Regular C]
  [inst_2 : CategoryTheory.FinitaryExtensive C] {X Y : C} (f : X ⟶ Y) (A B : CategoryTheory.Subobject Y),
  (CategoryTheory.Subobject.pullback f).obj (A ⊔ B) =
    (CategoryTheory.Subobject.pullback f).obj A ⊔ (CategoryTheory.Subobject.pullback f).obj B
@CategoricalEssentialIncompleteness.SubobjectPredicates.map_sup : ∀ {C : Type u_2}
  [inst : CategoryTheory.Category.{u_1, u_2} C] [CategoryTheory.Limits.HasPullbacks C]
  [inst_2 : CategoryTheory.Limits.HasImages C] [inst_3 : CategoryTheory.Limits.HasBinaryCoproducts C] {X Y : C}
  (f : X ⟶ Y) [inst_4 : CategoryTheory.Mono f] (A B : CategoryTheory.Subobject X),
  (CategoryTheory.Subobject.map f).obj (A ⊔ B) =
    (CategoryTheory.Subobject.map f).obj A ⊔ (CategoryTheory.Subobject.map f).obj B
@CategoricalEssentialIncompleteness.SubobjectPredicates.inf_sup : ∀ {C : Type u_2}
  [inst : CategoryTheory.Category.{u_1, u_2} C] [inst_1 : CategoryTheory.Regular C]
  [inst_2 : CategoryTheory.FinitaryExtensive C] {X : C} (A B D : CategoryTheory.Subobject X),
  A ⊓ (B ⊔ D) = A ⊓ B ⊔ A ⊓ D
