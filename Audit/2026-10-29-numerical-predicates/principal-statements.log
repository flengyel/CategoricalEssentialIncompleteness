@CategoricalEssentialIncompleteness.Numerical.domainSubobject_inf : ∀ {X : CategoricalEssentialIncompleteness.Numerical}
  (a b : X.Domain), X.domainSubobject (a ⊓ b) = X.domainSubobject a ⊓ X.domainSubobject b
@CategoricalEssentialIncompleteness.Numerical.domainSubobject_sup : ∀ {X : CategoricalEssentialIncompleteness.Numerical}
  (a b : X.Domain), X.domainSubobject (a ⊔ b) = X.domainSubobject a ⊔ X.domainSubobject b
