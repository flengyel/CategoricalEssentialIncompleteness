CategoricalEssentialIncompleteness.NumericalPER.supportSubobject_top : ∀ (X : Set ℕ),
  CategoricalEssentialIncompleteness.NumericalPER.supportSubobject X ⋯ = ⊤
CategoricalEssentialIncompleteness.NumericalPER.supportSubobject_bot : ∀ (X : Set ℕ),
  CategoricalEssentialIncompleteness.NumericalPER.supportSubobject ∅ ⋯ = ⊥
@CategoricalEssentialIncompleteness.NumericalPER.supportSubobject_inf : ∀ {A B X : Set ℕ} (hA : A ⊆ X) (hB : B ⊆ X),
  CategoricalEssentialIncompleteness.NumericalPER.supportSubobject (A ∩ B) ⋯ =
    CategoricalEssentialIncompleteness.NumericalPER.supportSubobject A hA ⊓
      CategoricalEssentialIncompleteness.NumericalPER.supportSubobject B hB
@CategoricalEssentialIncompleteness.NumericalPER.supportSubobject_sup : ∀ {A B X : Set ℕ},
  (REPred fun x => x ∈ A) →
    (REPred fun x => x ∈ B) →
      ∀ (hAX : A ⊆ X) (hBX : B ⊆ X),
        CategoricalEssentialIncompleteness.NumericalPER.supportSubobject (A ∪ B) ⋯ =
          CategoricalEssentialIncompleteness.NumericalPER.supportSubobject A hAX ⊔
            CategoricalEssentialIncompleteness.NumericalPER.supportSubobject B hBX
@CategoricalEssentialIncompleteness.NumericalPER.supportSubobject_pullback : ∀ {X Y A : Set ℕ}
  (f :
    (CategoricalEssentialIncompleteness.NumericalPER.discrete X).Representative
      (CategoricalEssentialIncompleteness.NumericalPER.discrete Y))
  (hA : A ⊆ Y),
  (CategoryTheory.Subobject.pullback (CategoricalEssentialIncompleteness.NumericalPER.ofRepresentative f)).obj
      (CategoricalEssentialIncompleteness.NumericalPER.supportSubobject A hA) =
    CategoricalEssentialIncompleteness.NumericalPER.supportSubobject
      (CategoricalEssentialIncompleteness.NumericalPER.inverseSupport f A) ⋯
@CategoricalEssentialIncompleteness.Numerical.domainInverse_bot : ∀ {X Y : CategoricalEssentialIncompleteness.Numerical}
  (f : X ⟶ Y), CategoricalEssentialIncompleteness.Numerical.domainInverse f ⊥ = ⊥
@CategoricalEssentialIncompleteness.Numerical.domainInverse_inf : ∀ {X Y : CategoricalEssentialIncompleteness.Numerical}
  (f : X ⟶ Y) (a b : Y.Domain),
  CategoricalEssentialIncompleteness.Numerical.domainInverse f (a ⊓ b) =
    CategoricalEssentialIncompleteness.Numerical.domainInverse f a ⊓
      CategoricalEssentialIncompleteness.Numerical.domainInverse f b
@CategoricalEssentialIncompleteness.Numerical.domainInverse_sup : ∀ {X Y : CategoricalEssentialIncompleteness.Numerical}
  (f : X ⟶ Y) (a b : Y.Domain),
  CategoricalEssentialIncompleteness.Numerical.domainInverse f (a ⊔ b) =
    CategoricalEssentialIncompleteness.Numerical.domainInverse f a ⊔
      CategoricalEssentialIncompleteness.Numerical.domainInverse f b
@CategoricalEssentialIncompleteness.Numerical.domainInverse_top : ∀
  {X Y : CategoricalEssentialIncompleteness.Numerical.Total} (f : X ⟶ Y),
  CategoricalEssentialIncompleteness.Numerical.domainInverse f.hom ⊤ = ⊤
CategoricalEssentialIncompleteness.Numerical.domainInverse_id : ∀ (X : CategoricalEssentialIncompleteness.Numerical)
  (e : X.Domain), CategoricalEssentialIncompleteness.Numerical.domainInverse (CategoryTheory.CategoryStruct.id X) e = e
@CategoricalEssentialIncompleteness.Numerical.domainInverse_comp : ∀
  {X Y Z : CategoricalEssentialIncompleteness.Numerical} (f : X ⟶ Y) (g : Y ⟶ Z) (e : Z.Domain),
  CategoricalEssentialIncompleteness.Numerical.domainInverse (CategoryTheory.CategoryStruct.comp f g) e =
    CategoricalEssentialIncompleteness.Numerical.domainInverse f
      (CategoricalEssentialIncompleteness.Numerical.domainInverse g e)
@CategoricalEssentialIncompleteness.Numerical.domainInverseHom : {X Y :
    CategoricalEssentialIncompleteness.Numerical.Total} →
  (X ⟶ Y) → BoundedLatticeHom Y.obj.Domain X.obj.Domain
CategoricalEssentialIncompleteness.Numerical.domainInverseHom_id : ∀
  (X : CategoricalEssentialIncompleteness.Numerical.Total),
  CategoricalEssentialIncompleteness.Numerical.domainInverseHom (CategoryTheory.CategoryStruct.id X) =
    BoundedLatticeHom.id X.obj.Domain
@CategoricalEssentialIncompleteness.Numerical.domainInverseHom_comp : ∀
  {X Y Z : CategoricalEssentialIncompleteness.Numerical.Total} (f : X ⟶ Y) (g : Y ⟶ Z),
  CategoricalEssentialIncompleteness.Numerical.domainInverseHom (CategoryTheory.CategoryStruct.comp f g) =
    (CategoricalEssentialIncompleteness.Numerical.domainInverseHom f).comp
      (CategoricalEssentialIncompleteness.Numerical.domainInverseHom g)
@CategoricalEssentialIncompleteness.Numerical.domainSubobject_naturality : ∀
  {X Y : CategoricalEssentialIncompleteness.Numerical.Total} (f : X ⟶ Y) (e : Y.obj.Domain),
  (CategoryTheory.Subobject.pullback (CategoricalEssentialIncompleteness.Numerical.toPER.map f)).obj
      (Y.obj.domainSubobject e) =
    X.obj.domainSubobject (CategoricalEssentialIncompleteness.Numerical.domainInverse f.hom e)
