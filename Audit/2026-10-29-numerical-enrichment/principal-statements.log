CategoricalEssentialIncompleteness.Numerical.enrichedTotalLift_ι : ∀
  (X Y : CategoricalEssentialIncompleteness.Numerical) (f : X.totalObject ⟶ Y.totalObject),
  (CategoryTheory.ConcreteCategory.hom (CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.totalι X Y))
      ((CategoryTheory.ConcreteCategory.hom (X.enrichedTotalLift Y)) f) =
    f.hom
CategoricalEssentialIncompleteness.Numerical.enrichedTotalEquiv : (X Y : CategoricalEssentialIncompleteness.Numerical) →
  CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.totalObject X Y ≃ (X.totalObject ⟶ Y.totalObject)
@CategoricalEssentialIncompleteness.Numerical.enrichedTotal_identity : ∀ {T : Type}
  (X : CategoricalEssentialIncompleteness.Numerical) (t : T),
  (X.enrichedTotalEquiv X)
      ((CategoryTheory.ConcreteCategory.hom
          ((CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.totalHom
                CategoricalEssentialIncompleteness.Numerical.enrichedProducts).identity
            X))
        t) =
    CategoryTheory.CategoryStruct.id X.totalObject
@CategoricalEssentialIncompleteness.Numerical.enrichedTotal_comp : ∀ {T : Type}
  {X Y Z : CategoricalEssentialIncompleteness.Numerical}
  (f : T ⟶ CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.totalObject X Y)
  (g : T ⟶ CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.totalObject Y Z) (t : T),
  (X.enrichedTotalEquiv Z)
      ((CategoryTheory.ConcreteCategory.hom
          ((CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.totalHom
                CategoricalEssentialIncompleteness.Numerical.enrichedProducts).comp
            f g))
        t) =
    CategoryTheory.CategoryStruct.comp ((X.enrichedTotalEquiv Y) ((CategoryTheory.ConcreteCategory.hom f) t))
      ((Y.enrichedTotalEquiv Z) ((CategoryTheory.ConcreteCategory.hom g) t))
@CategoricalEssentialIncompleteness.Numerical.enrichedTotal_pair : ∀ {T : Type}
  {X Y Z : CategoricalEssentialIncompleteness.Numerical}
  (f : T ⟶ CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.totalObject X Y)
  (g : T ⟶ CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.totalObject X Z) (t : T),
  (X.enrichedTotalEquiv (Y.product Z))
      ((CategoryTheory.ConcreteCategory.hom
          ((CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.totalHom
                CategoricalEssentialIncompleteness.Numerical.enrichedProducts).pair
            f g))
        t) =
    CategoricalEssentialIncompleteness.Numerical.totalPair
      ((X.enrichedTotalEquiv Y) ((CategoryTheory.ConcreteCategory.hom f) t))
      ((X.enrichedTotalEquiv Z) ((CategoryTheory.ConcreteCategory.hom g) t))
CategoricalEssentialIncompleteness.Numerical.internalIndexing : (V : CategoricalEssentialIncompleteness.Numerical) →
  CategoricalEssentialIncompleteness.Numerical.enrichedHom.hom
      (V.product CategoricalEssentialIncompleteness.Numerical.nat) CategoricalEssentialIncompleteness.Numerical.nat ⟶
    CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.totalObject V
      CategoricalEssentialIncompleteness.Numerical.nat
CategoricalEssentialIncompleteness.Numerical.internalEvaluation : (V : CategoricalEssentialIncompleteness.Numerical) →
  CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.totalObject V
      CategoricalEssentialIncompleteness.Numerical.nat ⟶
    CategoricalEssentialIncompleteness.Numerical.enrichedHom.hom
      (V.product CategoricalEssentialIncompleteness.Numerical.nat) CategoricalEssentialIncompleteness.Numerical.nat
@CategoricalEssentialIncompleteness.Numerical.internalEvaluation_composition : ∀ {T : Type}
  (V : CategoricalEssentialIncompleteness.Numerical)
  (g :
    T ⟶
      CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.totalObject V
        CategoricalEssentialIncompleteness.Numerical.nat),
  CategoryTheory.CategoryStruct.comp g V.internalEvaluation =
    CategoricalEssentialIncompleteness.Numerical.enrichedHom.comp
      (CategoricalEssentialIncompleteness.Numerical.enrichedHom.pair
        (CategoricalEssentialIncompleteness.Numerical.enrichedHom.comp
          (CategoricalEssentialIncompleteness.Numerical.enrichedHom.fst V
            CategoricalEssentialIncompleteness.Numerical.nat)
          (CategoryTheory.CategoryStruct.comp g
            (CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.totalι V
              CategoricalEssentialIncompleteness.Numerical.nat)))
        (CategoricalEssentialIncompleteness.Numerical.enrichedHom.snd V
          CategoricalEssentialIncompleteness.Numerical.nat))
      (TypeCat.ofHom fun x => CategoricalEssentialIncompleteness.Numerical.turingEvaluator)
CategoricalEssentialIncompleteness.Numerical.internalIndexing_evaluation : ∀
  (V : CategoricalEssentialIncompleteness.Numerical),
  CategoryTheory.CategoryStruct.comp V.internalIndexing V.internalEvaluation =
    CategoryTheory.CategoryStruct.id
      (CategoricalEssentialIncompleteness.Numerical.enrichedHom.hom
        (V.product CategoricalEssentialIncompleteness.Numerical.nat) CategoricalEssentialIncompleteness.Numerical.nat)
