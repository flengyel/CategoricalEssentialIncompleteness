@CategoricalEssentialIncompleteness.Numerical.enrichedDomainInverse_apply : ∀ {T : Type}
  {X Y : CategoricalEssentialIncompleteness.Numerical}
  (f : T ⟶ CategoricalEssentialIncompleteness.Numerical.enrichedHom.hom X Y)
  (e : T ⟶ CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.domainObject Y) (t : T),
  X.enrichedDomainEquiv
      ((CategoryTheory.ConcreteCategory.hom
          (CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.domainInverse f e))
        t) =
    CategoricalEssentialIncompleteness.Numerical.domainInverse ((CategoryTheory.ConcreteCategory.hom f) t)
      (Y.enrichedDomainEquiv ((CategoryTheory.ConcreteCategory.hom e) t))
@CategoricalEssentialIncompleteness.Numerical.enrichedDomainFamilyEquiv_inverse : ∀ {T : Type}
  {X Y : CategoricalEssentialIncompleteness.Numerical}
  (f : T ⟶ CategoricalEssentialIncompleteness.Numerical.enrichedHom.hom X Y)
  (e : T ⟶ CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.domainObject Y),
  (CategoricalEssentialIncompleteness.Numerical.enrichedDomainFamilyEquiv T X)
      (CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.domainInverse f e) =
    fun t =>
    CategoricalEssentialIncompleteness.Numerical.domainInverse ((CategoryTheory.ConcreteCategory.hom f) t)
      ((CategoricalEssentialIncompleteness.Numerical.enrichedDomainFamilyEquiv T Y) e t)
