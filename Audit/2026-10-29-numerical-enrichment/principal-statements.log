@CategoricalEssentialIncompleteness.Numerical.enriched_domainSubobject_apply : ∀
  {X : CategoricalEssentialIncompleteness.Numerical}
  (a : CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.GlobalDomain X),
  (CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.domainSubobject
        CategoricalEssentialIncompleteness.Numerical.enrichedProducts
        CategoricalEssentialIncompleteness.Numerical.enrichedPredicates
        CategoricalEssentialIncompleteness.Numerical.enrichedPredicateEmbedding
        CategoricalEssentialIncompleteness.Numerical.enrichedPredicateSubobjectIdentification X)
      a =
    X.domainSubobject
      (X.enrichedDomainEquiv
        ((CategoryTheory.ConcreteCategory.hom
            ((CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.globalDomainOrderIso X).symm a))
          default))
