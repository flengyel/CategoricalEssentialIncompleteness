@CategoricalEssentialIncompleteness.Numerical.enrichedTotal_globalTotalPoint : ∀
  {X Y : CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.GlobalTotal} (f : X ⟶ Y),
  (X.obj.obj.enrichedTotalEquiv Y.obj.obj)
