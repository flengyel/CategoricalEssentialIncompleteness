@CategoricalEssentialIncompleteness.Numerical.enrichedDomainFamilyEquiv_precomp : ∀ {T T' : Type}
  {X : CategoricalEssentialIncompleteness.Numerical} (k : T' ⟶ T)
  (e : T ⟶ CategoricalEssentialIncompleteness.Numerical.enrichedRestriction.domainObject X),
  (CategoricalEssentialIncompleteness.Numerical.enrichedDomainFamilyEquiv T' X)
      (CategoryTheory.CategoryStruct.comp k e) =
    fun t =>
    (CategoricalEssentialIncompleteness.Numerical.enrichedDomainFamilyEquiv T X) e
